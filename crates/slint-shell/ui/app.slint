export { Theme } from "theme.slint";
import { Theme } from "theme.slint";
import { MenuBar as CustomMenuBar, MenuItem as CustomMenuItem } from "components/menu-bar.slint";
import { MenuPopup } from "components/menu-popup.slint";
import { ToolBar } from "components/tool-bar.slint";
import { ToolRail, RightRail } from "components/tool-rail.slint";
import { TabStrip, TabItem } from "components/tab-strip.slint";
import { Breadcrumb } from "components/breadcrumb.slint";
import { ProjectTree, TreeItem } from "components/project-tree.slint";
import { CommitPanel, ChangeRow } from "components/commit-panel.slint";
import { DebuggerPanel } from "components/debugger-panel.slint";
import { StatusBar } from "components/status-bar.slint";
import { EditorView } from "components/editor-view.slint";
import { BottomBar, BottomDock, FindRow } from "components/bottom-dock.slint";
import { AgentDock, AgentLine } from "components/agent-dock.slint";
import { Welcome } from "components/welcome.slint";

export component AppWindow inherits Window {
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 360px;
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.base;
    default-font-family: root.app-font-name;
    default-font-size: root.app-font-size;

    // ── Editor ───────────────────────────────────────────────────────────
    in property <[TabItem]> tabs;
    in property <image> pane;
    in property <string> pane-message;
    in property <image> minimap;
    in property <bool> minimap-visible: false;
    in property <length> cursor-x: 0px;
    in property <length> cursor-y: 0px;
    in property <[string]> breadcrumbs;

    out property <length> editor-view-width: editor-pane.view-width;
    out property <length> editor-view-height: editor-pane.view-height;

    // ── Left dock ────────────────────────────────────────────────────────
    in property <int> active-rail: 0;
    in property <[TreeItem]> tree;
    in property <string> tree-title: "Project";
    in property <string> tree-empty;
    in property <string> selected-path;
    in property <[ChangeRow]> changes;
    in-out property <string> commit-message;
    in property <bool> debug-active;
    in property <[string]> debug-frames;
    in property <string> debug-console;

    // ── Bottom dock ──────────────────────────────────────────────────────
    in property <int> bottom-tool: -1;
    in property <string> terminal-text;
    in property <image> terminal-image;
    in property <[string]> terminal-sessions;
    in property <int> terminal-active: 0;
    in property <[FindRow]> find-rows;
    in property <string> output-title;
    in property <string> output-text;
    in property <string> bottom-title;

    // ── Right dock ───────────────────────────────────────────────────────
    in property <bool> agent-open;
    in property <[AgentLine]> agent-lines;
    in-out property <string> agent-prompt;
    in property <bool> agent-running;

    // ── Status ───────────────────────────────────────────────────────────
    in property <string> status-file;
    in property <bool> status-modified: false;
    in property <string> status-message;
    in property <bool> status-error: false;
    in property <string> status-branch;
    in property <string> status-position;
    in property <string> status-mode;
    in property <string> status-encoding: "UTF-8";

    // ── Overlays ─────────────────────────────────────────────────────────
    in property <[CustomMenuItem]> menu-items;
    in-out property <bool> menu-visible;
    in property <length> menu-x: 0px;
    in property <[string]> recents;
    in property <bool> show-welcome;

    // ── Hover card ───────────────────────────────────────────────────────
    in property <bool> hover-visible: false;
    in property <length> hover-x: 0px;
    in property <length> hover-y: 0px;
    in property <[string]> hover-lines;

    // ── Completion popup ─────────────────────────────────────────────────
    in property <bool> completion-visible: false;
    in property <length> completion-x: 0px;
    in property <length> completion-y: 0px;
    in property <[string]> completion-items;
    in property <int> completion-selected: 0;

    // ── Quickfix menu ────────────────────────────────────────────────────
    in property <bool> quickfix-visible: false;
    in property <length> quickfix-x: 0px;
    in property <length> quickfix-y: 0px;
    in property <[string]> quickfix-items;
    in property <int> quickfix-selected: 0;

    // ── Dialog ───────────────────────────────────────────────────────────
    in-out property <bool> dialog-visible: false;
    in property <string> dialog-title: "";
    in-out property <string> dialog-input: "";

    // ── Settings ─────────────────────────────────────────────────────────
    in-out property <bool> settings-visible: false;
    in-out property <int> settings-category: 0;
    in-out property <string> settings-app-font-name: "";
    in-out property <string> settings-app-font-size: "12";
    in-out property <string> settings-editor-font-name: "";
    in-out property <string> settings-editor-font-size: "15";
    in-out property <bool> settings-ligatures: false;

    // ── App-wide font ────────────────────────────────────────────────────
    in-out property <string> app-font-name: "";
    in-out property <length> app-font-size: 12px;

    callback apply-font-settings();
    callback key(string, bool, bool, bool, bool);
    callback mouse-pressed-left(length, length, bool, bool, bool, bool);
    callback mouse-pressed-right(length, length);
    callback mouse-pressed-middle(length, length);
    callback mouse-moved(length, length);
    callback mouse-hover(length, length);
    callback mouse-released();
    callback mouse-scrolled(length, length, length, length, bool, bool, bool, bool);
    callback ime-committed(string);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback tree-clicked(string);
    callback rail-selected(int);
    callback sidebar-refresh();
    callback sidebar-collapse();
    callback change-clicked(string, bool);
    callback commit();
    callback toggle-bottom(int);
    callback close-bottom();
    callback terminal-new();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);
    callback find-open(string, int);
    callback debug-cmd(string);
    callback agent-toggle();
    callback agent-submit();
    callback agent-stop();
    callback menu-opened(string, length);
    callback command(string);
    callback open-recent(string);

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open Folder…"; activated => { root.command("open-project-dialog"); } }
            MenuSeparator {}
            MenuItem { title: "Save"; activated => { root.command("save-buffer"); } }
            MenuItem { title: "Save All"; activated => { root.command("save-all"); } }
            MenuSeparator {}
            MenuItem { title: "Close Buffer"; activated => { root.command("close-buffer"); } }
            MenuItem { title: "Quit"; activated => { root.command("quit"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; activated => { root.command("undo"); } }
            MenuItem { title: "Redo"; activated => { root.command("redo"); } }
            MenuSeparator {}
            MenuItem { title: "Find in Buffers…"; activated => { root.command("dialog:find"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Project"; activated => { root.command("rail:0"); } }
            MenuItem { title: "Commit"; activated => { root.command("rail:1"); } }
            MenuItem { title: "Debugger"; activated => { root.command("rail:2"); } }
            MenuSeparator {}
            MenuItem { title: "Toggle Theme"; activated => { root.command("toggle-theme"); } }
            MenuItem { title: "Settings…"; activated => { root.command("dialog:settings"); } }
        }
        Menu {
            title: "Navigate";
            MenuItem { title: "Next Tab"; activated => { root.command("buffer-next"); } }
            MenuItem { title: "Previous Tab"; activated => { root.command("buffer-prev"); } }
            MenuSeparator {}
            MenuItem { title: "Go to File…"; activated => { root.command("dialog:goto-file"); } }
            MenuItem { title: "Go to Symbol…"; activated => { root.command("dialog:goto-symbol"); } }
        }
        Menu {
            title: "Run";
            MenuItem { title: "Run"; activated => { root.command("run-config"); } }
            MenuItem { title: "Debug"; activated => { root.command("debug-config"); } }
            MenuItem { title: "Stop"; activated => { root.command("stop-config"); } }
            MenuSeparator {}
            MenuItem { title: "Refresh Version Control"; activated => { root.command("vc-refresh"); } }
        }
    }

    VerticalLayout {
        // ── Menu + main toolbar (JetBrains New UI single band) ───────────
        Rectangle {
            height: Theme.menu-height;
            background: Theme.crust;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                alignment: start;

                Rectangle { horizontal-stretch: 1; }

                ToolBar {
                    run => { root.command("run-config"); }
                    debug => { root.command("debug-config"); }
                    stop => { root.command("stop-config"); }
                    build => { root.command("make"); }
                    test => { root.command("make"); }
                    settings => { root.command("dialog:settings"); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Tabs + breadcrumb ────────────────────────────────────────────
        TabStrip {
            tabs: root.tabs;
            selected(i) => { root.tab-clicked(i); }
            closed(i) => { root.tab-closed(i); }
        }

        Breadcrumb { segments: root.breadcrumbs; }

        // ── Rail + left dock + editor + right dock ───────────────────────
        HorizontalLayout {
            ToolRail {
                active: root.active-rail;
                selected(i) => { root.rail-selected(i); }
            }

            if root.active-rail == 0 : ProjectTree {
                width: Theme.sidebar-width;
                title: root.tree-title;
                rows: root.tree;
                selected-path: root.selected-path;
                empty-message: root.tree-empty;
                activated(path) => { root.tree-clicked(path); }
                refresh => { root.sidebar-refresh(); }
                collapse => { root.sidebar-collapse(); }
            }

            if root.active-rail == 1 : CommitPanel {
                width: Theme.sidebar-width;
                branch: root.status-branch;
                changes: root.changes;
                message <=> root.commit-message;
                change-clicked(path, staged) => { root.change-clicked(path, staged); }
                commit => { root.commit(); }
            }

            if root.active-rail == 2 : DebuggerPanel {
                width: 440px;
                active: root.debug-active;
                frames: root.debug-frames;
                console: root.debug-console;
                command(cmd) => { root.debug-cmd(cmd); }
            }

            editor-pane := EditorView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-width: 120px;
                    max-width: 100000px;
                    pane: root.pane;
                    pane-message: root.pane-message;
                    minimap: root.minimap;
                    minimap-visible: root.minimap-visible;
                    cursor-x: root.cursor-x;
                    cursor-y: root.cursor-y;
                    key(text, ctrl, shift, alt, meta) => {
                        root.key(text, ctrl, shift, alt, meta);
                    }
                mouse-pressed-left(x, y, ctrl, shift, alt, meta) => {
                    root.mouse-pressed-left(x, y, ctrl, shift, alt, meta);
                }
                mouse-pressed-right(x, y) => {
                    root.mouse-pressed-right(x, y);
                }
                mouse-pressed-middle(x, y) => {
                    root.mouse-pressed-middle(x, y);
                }
                mouse-moved(x, y) => {
                    root.mouse-moved(x, y);
                }
                mouse-hover(x, y) => {
                    root.mouse-hover(x, y);
                }
                mouse-released() => {
                    root.mouse-released();
                }
                mouse-scrolled(x, y, dx, dy, ctrl, shift, alt, meta) => {
                    root.mouse-scrolled(x, y, dx, dy, ctrl, shift, alt, meta);
                }
                ime-committed(text) => {
                    root.ime-committed(text);
                }
            }

            if root.agent-open : AgentDock {
                lines: root.agent-lines;
                prompt <=> root.agent-prompt;
                running: root.agent-running;
                submit => { root.agent-submit(); }
                stop => { root.agent-stop(); }
            }

            RightRail {
                open: root.agent-open;
                toggled => { root.agent-toggle(); }
            }
        }

        // ── Bottom dock + bar ────────────────────────────────────────────
        if root.bottom-tool >= 0 : BottomDock {
            tool: root.bottom-tool;
            title: root.bottom-title;
            terminal-text: root.terminal-text;
            terminal-image: root.terminal-image;
            terminal-sessions: root.terminal-sessions;
            terminal-active: root.terminal-active;
            find-rows: root.find-rows;
            output-title: root.output-title;
            output-text: root.output-text;
            close => { root.close-bottom(); }
            terminal-new => { root.terminal-new(); }
            terminal-focus(i) => { root.terminal-focus(i); }
            terminal-close(i) => { root.terminal-close(i); }
            terminal-scroll(d) => { root.terminal-scroll(d); }
            find-open(path, line) => { root.find-open(path, line); }
        }

        BottomBar {
            active: root.bottom-tool;
            toggle(i) => { root.toggle-bottom(i); }
        }

        // ── Status bar ───────────────────────────────────────────────────
        StatusBar {
            file: root.status-file;
            modified: root.status-modified;
            message: root.status-message;
            message-error: root.status-error;
            branch: root.status-branch;
            position: root.status-position;
            mode: root.status-mode;
            encoding: root.status-encoding;
        }
    }

    // Click-away layer for the open menu.
    if root.menu-visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.menu-visible = false; }
        }
    }

    if root.menu-visible : MenuPopup {
        x: root.menu-x;
        y: Theme.menu-height;
        items: root.menu-items;
        activated(cmd) => {
            root.menu-visible = false;
            root.command(cmd);
        }
    }

    if root.show-welcome : Welcome {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        recents: root.recents;
        open-folder => { root.command("open-project-dialog"); }
        open-recent(path) => { root.open-recent(path); }
    }

    // ── Settings overlay ─────────────────────────────────────────────────
    if root.settings-visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            clicked => { root.settings-visible = false; }
        }

        Rectangle {
            x: (parent.width - 640px) / 2;
            y: (parent.height - 480px) / 2;
            width: 640px;
            height: 480px;
            background: Theme.mantle;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { }
            }

            Text {
                x: 20px;
                y: 16px;
                text: "Settings";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }

            // ── Category list (left) ─────────────────────────────────────
            Rectangle {
                x: 0;
                y: 48px;
                width: 150px;
                height: parent.height - 48px;
                background: Theme.crust;
            }

            // Use explicit category buttons instead of for-loop with tuples
            Rectangle {
                x: 8px;
                y: 56px;
                width: 134px;
                height: 26px;
                border-radius: Theme.radius;
                background: root.settings-category == 0 ? Theme.surface1 : (cat0.has-hover ? Theme.surface0 : transparent);
                Text { x: 10px; text: "General"; color: root.settings-category == 0 ? Theme.text : Theme.subtext0; font-size: 12px; vertical-alignment: center; }
                cat0 := TouchArea { clicked => { root.settings-category = 0; } }
            }
            Rectangle {
                x: 8px;
                y: 84px;
                width: 134px;
                height: 26px;
                border-radius: Theme.radius;
                background: root.settings-category == 1 ? Theme.surface1 : (cat1.has-hover ? Theme.surface0 : transparent);
                Text { x: 10px; text: "Appearance"; color: root.settings-category == 1 ? Theme.text : Theme.subtext0; font-size: 12px; vertical-alignment: center; }
                cat1 := TouchArea { clicked => { root.settings-category = 1; } }
            }
            Rectangle {
                x: 8px;
                y: 112px;
                width: 134px;
                height: 26px;
                border-radius: Theme.radius;
                background: root.settings-category == 2 ? Theme.surface1 : (cat2.has-hover ? Theme.surface0 : transparent);
                Text { x: 10px; text: "Editor"; color: root.settings-category == 2 ? Theme.text : Theme.subtext0; font-size: 12px; vertical-alignment: center; }
                cat2 := TouchArea { clicked => { root.settings-category = 2; } }
            }
            Rectangle {
                x: 8px;
                y: 140px;
                width: 134px;
                height: 26px;
                border-radius: Theme.radius;
                background: root.settings-category == 3 ? Theme.surface1 : (cat3.has-hover ? Theme.surface0 : transparent);
                Text { x: 10px; text: "Terminal"; color: root.settings-category == 3 ? Theme.text : Theme.subtext0; font-size: 12px; vertical-alignment: center; }
                cat3 := TouchArea { clicked => { root.settings-category = 3; } }
            }
            Rectangle {
                x: 8px;
                y: 168px;
                width: 134px;
                height: 26px;
                border-radius: Theme.radius;
                background: root.settings-category == 4 ? Theme.surface1 : (cat4.has-hover ? Theme.surface0 : transparent);
                Text { x: 10px; text: "Behavior"; color: root.settings-category == 4 ? Theme.text : Theme.subtext0; font-size: 12px; vertical-alignment: center; }
                cat4 := TouchArea { clicked => { root.settings-category = 4; } }
            }

            // ── Right pane ────────────────────────────────────────────────
            Rectangle {
                x: 150px;
                y: 48px;
                width: parent.width - 150px;
                height: parent.height - 48px;
                background: Theme.mantle;

                // Appearance category
                if root.settings-category == 1 : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Appearance"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: "Theme"; color: Theme.subtext0; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle { width: 100px; height: 28px; border-radius: Theme.radius; background: t1.has-hover ? Theme.surface2 : Theme.surface1; Text { text: "IntelliJ Dark"; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } t1 := TouchArea { clicked => { root.command("settings:theme:intellij-dark"); } } }
                        Rectangle { width: 100px; height: 28px; border-radius: Theme.radius; background: t2.has-hover ? Theme.surface2 : Theme.surface1; Text { text: "IntelliJ Light"; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } t2 := TouchArea { clicked => { root.command("settings:theme:intellij-light"); } } }
                        Rectangle { width: 100px; height: 28px; border-radius: Theme.radius; background: t3.has-hover ? Theme.surface2 : Theme.surface1; Text { text: "Mocha"; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } t3 := TouchArea { clicked => { root.command("settings:theme:mocha"); } } }
                        Rectangle { width: 100px; height: 28px; border-radius: Theme.radius; background: t4.has-hover ? Theme.surface2 : Theme.surface1; Text { text: "Latte"; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } t4 := TouchArea { clicked => { root.command("settings:theme:latte"); } } }
                    }
                    Text { text: "Font (app-wide)"; color: Theme.subtext0; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Name"; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 60px; }
                        Rectangle {
                            width: 220px;
                            height: 28px;
                            background: Theme.surface0;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: parent.height - 8px;
                                text <=> root.settings-app-font-name;
                                color: Theme.text;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Size"; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 60px; }
                        Rectangle {
                            width: 80px;
                            height: 28px;
                            background: Theme.surface0;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: parent.height - 8px;
                                text <=> root.settings-app-font-size;
                                color: Theme.text;
                            }
                        }
                    }
                }

                // Editor category
                if root.settings-category == 2 : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Editor"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: "Font"; color: Theme.subtext0; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Name"; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 60px; }
                        Rectangle {
                            width: 220px;
                            height: 28px;
                            background: Theme.surface0;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: parent.height - 8px;
                                text <=> root.settings-editor-font-name;
                                color: Theme.text;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Size"; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 60px; }
                        Rectangle {
                            width: 80px;
                            height: 28px;
                            background: Theme.surface0;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: parent.height - 8px;
                                text <=> root.settings-editor-font-size;
                                color: Theme.text;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Ligatures"; color: Theme.text; font-size: 11px; vertical-alignment: center; width: 60px; }
                        Rectangle {
                            width: 60px;
                            height: 28px;
                            border-radius: Theme.radius;
                            background: root.settings-ligatures ? Theme.blue : Theme.surface1;
                            Text {
                                text: root.settings-ligatures ? "On" : "Off";
                                color: Theme.text;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.settings-ligatures = !root.settings-ligatures; }
                            }
                        }
                    }
                    Rectangle { height: 26px; background: Theme.surface0; border-radius: Theme.radius; Text { x: 8px; text: "Toggle Minimap"; color: Theme.text; font-size: 12px; vertical-alignment: center; } TouchArea { clicked => { root.command("toggle-minimap"); } } }
                    Rectangle { height: 26px; background: Theme.surface0; border-radius: Theme.radius; Text { x: 8px; text: "Toggle Mouse Support"; color: Theme.text; font-size: 12px; vertical-alignment: center; } TouchArea { clicked => { root.command("toggle-mouse"); } } }
                    Rectangle { height: 26px; background: Theme.surface0; border-radius: Theme.radius; Text { x: 8px; text: "Toggle Line Numbers"; color: Theme.text; font-size: 12px; vertical-alignment: center; } TouchArea { clicked => { root.command("toggle-line-numbers"); } } }
                    Rectangle { height: 26px; background: Theme.surface0; border-radius: Theme.radius; Text { x: 8px; text: "Toggle Word Wrap"; color: Theme.text; font-size: 12px; vertical-alignment: center; } TouchArea { clicked => { root.command("toggle-wrap"); } } }
                }

                // Terminal category
                if root.settings-category == 3 : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Terminal"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: "Terminal settings (shell, font) coming soon."; color: Theme.overlay0; font-size: 11px; }
                }

                // Behavior category
                if root.settings-category == 4 : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Behavior"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Rectangle { height: 26px; background: Theme.surface0; border-radius: Theme.radius; Text { x: 8px; text: "Toggle Auto-save"; color: Theme.text; font-size: 12px; vertical-alignment: center; } TouchArea { clicked => { root.command("toggle-auto-save"); } } }
                }

                // General category
                if root.settings-category == 0 : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "General"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: "Application-wide preferences."; color: Theme.overlay0; font-size: 11px; }
                }
            }

            Rectangle {
                x: parent.width - 184px;
                y: parent.height - 36px;
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: Theme.surface1;
                Text {
                    text: "Apply";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.apply-font-settings(); }
                }
            }
            Rectangle {
                x: parent.width - 96px;
                y: parent.height - 36px;
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: Theme.blue;
                Text {
                    text: "Close";
                    color: Theme.crust;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.settings-visible = false; }
                }
            }
        }
    }

    // ── Dialog overlay ───────────────────────────────────────────────────
    if root.dialog-visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            // click-away closes (behind the dialog)
            clicked => { root.dialog-visible = false; }
        }

        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 160px) / 2;
            width: 420px;
            height: 160px;
            background: Theme.mantle;

            TouchArea {
                // consume clicks so the dialog doesn't close
                width: 100%;
                height: 100%;
                clicked => { }
            }
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                x: 16px;
                y: 12px;
                text: root.dialog-title;
                color: Theme.text;
                font-size: Theme.font-ui;
                font-weight: 600;
            }

            Rectangle {
                x: 16px;
                y: 44px;
                width: parent.width - 32px;
                height: 28px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.crust;

                TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    text <=> root.dialog-input;
                    color: Theme.text;
                    font-size: Theme.font-ui;
                    single-line: true;
                    accepted => { root.command("dialog:ok"); }
                }
            }

            HorizontalLayout {
                x: 16px;
                y: parent.height - 40px;
                width: parent.width - 32px;
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 80px;
                    height: 26px;
                    border-radius: Theme.radius;
                    background: touch.has-hover ? Theme.surface0 : Theme.surface1;
                    Text {
                        text: "Cancel";
                        color: Theme.text;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        clicked => { root.dialog-visible = false; }
                    }
                }
                Rectangle {
                    width: 80px;
                    height: 26px;
                    border-radius: Theme.radius;
                    background: Theme.blue;
                    Text {
                        text: "OK";
                        color: Theme.crust;
                        font-size: Theme.font-small;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.command("dialog:ok"); }
                    }
                }
            }
        }
    }

    // ── Hover card ───────────────────────────────────────────────────────
    if root.hover-visible : Rectangle {
        x: root.hover-x;
        y: root.hover-y;
        width: 260px;
        height: (root.hover-lines.length * 18px + 10px);
        background: Theme.crust;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.surface1;

        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            for line in root.hover-lines : Text {
                text: line;
                color: Theme.subtext1;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    // ── Completion popup ─────────────────────────────────────────────────
    if root.completion-visible : Rectangle {
        x: root.completion-x;
        y: root.completion-y;
        width: 220px;
        height: (root.completion-items.length * 18px + 8px).min(200px);
        background: Theme.crust;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.surface1;

        VerticalLayout {
            padding: 4px;
            for item[i] in root.completion-items : Rectangle {
                height: 18px;
                background: i == root.completion-selected ? Theme.surface1 : transparent;
                Text {
                    x: 8px;
                    text: item;
                    color: i == root.completion-selected ? Theme.text : Theme.subtext1;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Quickfix menu ────────────────────────────────────────────────────
    if root.quickfix-visible : Rectangle {
        x: root.quickfix-x;
        y: root.quickfix-y;
        width: 260px;
        height: (root.quickfix-items.length * 18px + 10px).min(240px);
        background: Theme.crust;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.blue;

        VerticalLayout {
            padding: 5px;
            for item[i] in root.quickfix-items : Rectangle {
                height: 18px;
                background: i == root.quickfix-selected ? Theme.surface1 : transparent;
                Text {
                    x: 8px;
                    text: item;
                    color: i == root.quickfix-selected ? Theme.text : Theme.subtext1;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
