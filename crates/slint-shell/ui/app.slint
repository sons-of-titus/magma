export { Theme } from "theme.slint";
export { WelcomeWindow } from "welcome-window.slint";
import { Theme } from "theme.slint";
import { MenuBar as CustomMenuBar, MenuItem as CustomMenuItem } from "components/menu-bar.slint";
import { MenuPopup } from "components/menu-popup.slint";
import { ToolBar } from "components/tool-bar.slint";
import { ToolRail, RightRail } from "components/tool-rail.slint";
import { TabStrip, TabItem } from "components/tab-strip.slint";
import { Breadcrumb } from "components/breadcrumb.slint";
import { ProjectTree, TreeItem } from "components/project-tree.slint";
import { CommitPanel, ChangeRow } from "components/commit-panel.slint";
import { DebuggerPanel } from "components/debugger-panel.slint";
import { DatabasePanel, DbTreeRow, DbColumn, DbRow, FormButton as DialogButton } from "components/database-panel.slint";
import { Field } from "components/controls.slint";
import { DebugFrameRow, DebugVarRow, DebugWatchRow, DebugBpRow, ConsoleRow } from "components/debug-rows.slint";
import { StatusBar } from "components/status-bar.slint";
import { ProgressStrip, ProgressTask } from "components/progress-strip.slint";
import { EditorView } from "components/editor-view.slint";
import { BottomBar, BottomDock, FindRow, GitHistoryRow, ProblemRow } from "components/bottom-dock.slint";
import { AgentDock, AgentEntry, AgentSessionChip } from "components/agent-dock.slint";
import { SettingsView, SettingsRow, PluginRow } from "views/settings-view.slint";
import { DialogView } from "views/dialog-view.slint";
import { QuitView } from "views/quit-view.slint";
import { NewProjectView, TemplateItem, TemplateVar } from "views/new-project-view.slint";
import { HoverCard, CompletionPopup, QuickfixMenu, CompletionEntry } from "views/overlays.slint";
import { WindowControls, WindowResizeEdges } from "components/window-chrome.slint";
import { ComboBox, SpinBox } from "std-widgets.slint";
export component AppWindow inherits Window {
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 360px;
    max-width: 100000px;
    max-height: 100000px;
    // No native decorations: the chrome band drags the window, the window
    // controls close/minimize, and WindowResizeEdges resizes.
    no-frame: true;
    background: Theme.surface;
    default-font-family: root.app-font-name;
    default-font-size: root.app-font-size;

    // ── Editor ───────────────────────────────────────────────────────────
    in property <[TabItem]> tabs;
    in property <image> pane;
    in property <length> pane-width: 0px;
    in property <length> pane-height: 0px;
    in property <string> pane-message;
    in property <image> minimap;
    in property <bool> minimap-visible: false;
    in property <image> gutter;
    in property <bool> gutter-visible: false;
    in property <length> gutter-width: 0px;
    in property <length> cursor-x: 0px;
    in property <length> cursor-height: 20px;
    in property <bool> caret-visible: false;
    in property <color> caret-color;
    in property <length> cursor-y: 0px;
    in property <[string]> breadcrumbs;
    in property <bool> breadcrumb-enabled: true;

    out property <length> editor-view-width: editor-pane.view-width;
    out property <length> editor-view-height: editor-pane.view-height;

    // ── Left dock ────────────────────────────────────────────────────────
    in property <int> active-rail: 0;
    in property <bool> sidebar-open: true;
    in property <bool> db-open: false;
    in property <length> db-height: 340px;
    in property <[string]> db-sources;
    in property <string> db-active-source;
    in property <bool> db-connected: false;
    in property <string> db-connected-label;
    in property <bool> db-busy: false;
    in property <bool> db-form-open: false;
    in-out property <string> db-form-name;
    in-out property <string> db-form-path;
    in property <string> db-form-note;
    in property <[DbTreeRow]> db-tree;
    in property <[DbColumn]> db-columns;
    in property <[DbRow]> db-rows;
    in property <string> db-status;
    in property <bool> db-status-error: false;
    in property <bool> db-truncated: false;
    in property <string> db-row-count;
    in property <string> db-elapsed;
    in property <length> sidebar-width: 300px;
    in property <[TreeItem]> tree;
    in property <string> tree-title: "Project";
    in property <string> tree-empty;
    in property <string> selected-path;

    // ── Commit tool window ───────────────────────────────────────────────
    in property <bool> vc-has-repo: false;
    in property <string> vc-repo-label: "";
    in property <string> vc-branch;
    in property <[string]> vc-branches;
    in property <bool> vc-has-staging: true;
    in property <[ChangeRow]> staged-changes;
    in property <[ChangeRow]> unstaged-changes;
    in property <[ChangeRow]> untracked-changes;
    in property <[ChangeRow]> conflict-changes;
    in property <bool> vc-busy: false;
    in property <string> vc-error: "";
    in-out property <string> commit-message;
    in-out property <bool> commit-amend: false;

    // ── Debug tool window ────────────────────────────────────────────────
    in property <string> debug-phase: "none";
    in property <string> debug-status;
    in property <string> debug-adapter;
    in property <bool> debug-can-resume: false;
    in property <bool> debug-can-pause: false;
    in property <bool> debug-can-step: false;
    in property <bool> debug-can-stop: false;
    in property <bool> debug-can-restart: false;
    in property <[DebugFrameRow]> debug-frames;
    in property <[DebugVarRow]> debug-vars;
    in property <[DebugWatchRow]> debug-watches;
    in property <[DebugBpRow]> debug-breakpoints;
    in property <[ConsoleRow]> debug-console;
    in property <int> debug-console-total: 0;
    in-out property <string> debug-watch-draft;

    // ── Bottom dock ──────────────────────────────────────────────────────
    in property <int> bottom-tool: -1;
    in property <string> terminal-text;
    in property <image> terminal-image;
    in property <[string]> terminal-sessions;
    in property <int> terminal-active: 0;
    in property <[FindRow]> find-rows;
    in property <string> output-title;
    in property <string> output-text;
    in property <[ProblemRow]> problems;
    in property <int> bottom-problems-count: 0;
    in property <int> bottom-terminal-count: 0;
    in property <length> dock-height: 240px;
    in property <bool> output-follow: true;
    in property <[GitHistoryRow]> git-history;
    in property <string> bottom-title;
    in property <[ProgressTask]> progress-tasks;

    // ── Right dock ───────────────────────────────────────────────────────
    in property <bool> agent-open;
    in property <[AgentEntry]> agent-entries;
    in property <[AgentSessionChip]> agent-sessions;
    in property <bool> agent-configured: false;
    in property <[string]> agent-providers;
    in property <int> agent-turns-left: 0;
    in property <length> agent-dock-width: 380px;
    in-out property <string> agent-prompt;
    in property <bool> agent-running;
    in property <string> agent-phase: "ready";
    in property <string> agent-phase-detail: "";
    in property <string> agent-approval-summary: "";
    in property <[string]> agent-files;
    in property <[string]> agent-models;
    in-out property <string> agent-provider: "openai";
    in-out property <string> agent-model: "gpt-4o-mini";

    // ── Status ───────────────────────────────────────────────────────────
    in property <string> status-file;
    in property <bool> status-modified: false;
    in property <string> status-message;
    in property <bool> status-error: false;
    in property <string> status-branch;
    in property <string> status-position;
    in property <string> status-mode;
    in property <string> status-encoding: "UTF-8";

    // ── Overlays ─────────────────────────────────────────────────────────
    in property <[CustomMenuItem]> menu-items;
    in-out property <bool> menu-visible;
    in property <length> menu-x: 0px;

    // ── Hover card ───────────────────────────────────────────────────────
    in property <bool> hover-visible: false;
    in property <length> hover-x: 0px;
    in property <length> hover-y: 0px;
    in property <[string]> hover-lines;

    // ── Completion popup ─────────────────────────────────────────────────
    in property <bool> completion-visible: false;
    in property <length> completion-x: 0px;
    in property <length> completion-y: 0px;
    in property <[CompletionEntry]> completion-entries;
    in property <int> completion-selected: 0;
    in property <string> completion-info;

    // ── Quickfix menu ────────────────────────────────────────────────────
    in property <bool> quickfix-visible: false;
    in property <length> quickfix-x: 0px;
    in property <length> quickfix-y: 0px;
    in property <[string]> quickfix-items;
    in property <int> quickfix-selected: 0;

    // ── Dialog ───────────────────────────────────────────────────────────
    in-out property <bool> dialog-visible: false;
    in property <string> dialog-title: "";
    in-out property <string> dialog-input: "";

    // ── New Project wizard ───────────────────────────────────────────────
    in property <bool> new-project-visible: false;
    // Solo: no project is open, so the wizard replaces the editor chrome
    // instead of floating over it.
    in property <bool> new-project-solo: false;
    in property <[TemplateItem]> new-project-templates;
    in property <TemplateItem> new-project-detail;
    in property <[string]> new-project-languages;
    in property <string> new-project-language: "";
    in property <[TemplateVar]> new-project-vars;
    in-out property <string> new-project-search: "";
    in-out property <string> new-project-name: "";
    in-out property <string> new-project-dest: "";
    in property <string> new-project-note: "";
    in property <string> new-project-create-reason: "";
    in property <bool> new-project-can-create: false;
    in property <bool> new-project-generating: false;

    // ── Quit confirmation ────────────────────────────────────────────────
    in property <bool> quit-confirm-visible: false;
    in property <string> quit-confirm-message: "";
    in property <string> quit-confirm-files: "";

    // ── Settings ─────────────────────────────────────────────────────────
    in-out property <bool> settings-visible: false;
    in-out property <int> settings-category: 0;
    in property <[SettingsRow]> settings-rows;
    in-out property <string> settings-search: "";
    in-out property <string> settings-app-font-name: "";
    in-out property <int> settings-app-font-size: 12;
    in-out property <string> settings-editor-font-name: "";
    in-out property <int> settings-editor-font-size: 15;
    in-out property <bool> settings-ligatures: false;
    in-out property <string> settings-agent-provider: "openai";
    in-out property <string> settings-agent-token: "";
    in-out property <string> settings-agent-model: "";
    in property <[PluginRow]> settings-plugin-rows;

    // ── App-wide font ────────────────────────────────────────────────────
    in-out property <string> app-font-name: "";
    in-out property <length> app-font-size: 12px;
    in property <[string]> available-fonts;

    callback apply-font-settings();
    callback apply-agent-settings();
    callback set-option(string, string);
    callback reset-option(string);
    callback add-option(string, string);
    callback plugin-toggled(string, bool);
    callback settings-search-changed();
    callback settings-select-category(int);
    callback key(string, bool, bool, bool, bool);
    callback mouse-pressed-left(length, length, bool, bool, bool, bool);
    callback mouse-pressed-right(length, length);
    callback mouse-pressed-middle(length, length);
    callback mouse-moved(length, length);
    callback mouse-hover(length, length);
    callback mouse-released();
    callback mouse-scrolled(length, length, length, length, bool, bool, bool, bool);
    callback ime-committed(string);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback tree-clicked(string);
    callback rail-selected(int);
    callback db-toggle();
    callback db-resized(length);
    callback db-open-console();
    callback db-source-changed(string);
    callback db-connect-toggle();
    callback db-refresh-schema();
    callback db-form-opened();
    callback db-form-cancelled();
    callback db-source-created(string, string);
    callback db-test-connection(string, string);
    callback db-toggle-table(int);
    callback db-table-opened(int);
    callback db-run-query();
    callback db-cancel-query();
    callback sidebar-refresh();
    callback sidebar-collapse();
    callback sidebar-resized(length);
    callback change-clicked(string);
    callback stage-clicked(string, bool);
    callback discard-clicked(string);
    callback resolve-clicked(string, bool);
    callback branch-changed(string);
    callback commit();
    callback toggle-bottom(int);
    callback close-bottom();
    callback dock-resized(length);
    callback dock-resize-reset();
    callback output-clear();
    callback output-toggle-follow();
    callback terminal-new();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);
    callback find-open(string, int);
    callback debug-cmd(string);
    callback debug-frame-selected(int);
    callback debug-toggle-expand(int);
    callback debug-watch-add();
    callback debug-watch-remove(string);
    callback debug-bp-toggle(string, int, bool);
    callback debug-bp-remove(string, int);
    callback debug-bp-open(string, int);
    callback agent-toggle();
    callback agent-submit();
    callback agent-stop();
    callback agent-select-session(int);
    callback agent-toggle-expanded(int);
    callback agent-approve();
    callback agent-decline();
    callback agent-open-file(string);
    callback agent-provider-changed(string);
    callback agent-open-settings();
    callback agent-resized(length);
    callback menu-opened(string, length);
    callback command(string);
    // Frameless-window resize, applied by the shell (see window_chrome.rs).
    callback window-resize-begin(int);
    callback window-resize-move(int, length, length);

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New Project…"; activated => { root.command("new-project-dialog"); } }
            MenuItem { title: "Open Folder…"; activated => { root.command("open-project-dialog"); } }
            MenuSeparator {}
            MenuItem { title: "Save"; activated => { root.command("save-buffer"); } }
            MenuItem { title: "Save All"; activated => { root.command("save-all"); } }
            MenuSeparator {}
            MenuItem { title: "Close Buffer"; activated => { root.command("close-buffer"); } }
            MenuItem { title: "Quit"; activated => { root.command("quit"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; activated => { root.command("undo"); } }
            MenuItem { title: "Redo"; activated => { root.command("redo"); } }
            MenuSeparator {}
            MenuItem { title: "Find in Buffers…"; activated => { root.command("dialog:find"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Project"; activated => { root.command("rail:0"); } }
            MenuItem { title: "Commit"; activated => { root.command("rail:1"); } }
            MenuSeparator {}
            MenuItem { title: "Toggle Theme"; activated => { root.command("toggle-theme"); } }
            MenuItem { title: "Settings…"; activated => { root.command("dialog:settings"); } }
        }
        Menu {
            title: "Navigate";
            MenuItem { title: "Next Tab"; activated => { root.command("buffer-next"); } }
            MenuItem { title: "Previous Tab"; activated => { root.command("buffer-prev"); } }
            MenuSeparator {}
            MenuItem { title: "Go to File…"; activated => { root.command("dialog:goto-file"); } }
            MenuItem { title: "Go to Symbol…"; activated => { root.command("dialog:goto-symbol"); } }
        }
        Menu {
            title: "Run";
            MenuItem { title: "Run"; activated => { root.command("run-config"); } }
            MenuItem { title: "Debug"; activated => { root.command("debug-config"); } }
            MenuItem { title: "Stop"; activated => { root.command("stop-config"); } }
            MenuSeparator {}
            MenuItem { title: "Refresh Version Control"; activated => { root.command("vc-refresh"); } }
        }
    }

    // The whole editor chrome steps aside while the New Project wizard runs
    // solo (no project open): the wizard is the window's content then.
    VerticalLayout {
        visible: !root.new-project-solo;

        // ── Menu + main toolbar (JetBrains New UI single band) ───────────
        // The band is also the frameless window's drag handle; child
        // TouchAreas (toolbar, controls) still get their clicks.
        Rectangle {
            height: Theme.menu-height;
            background: Theme.chrome;

            WindowMoveArea {
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    alignment: end;

                    ToolBar {
                        run => { root.command("run-config"); }
                        debug => { root.command("debug-config"); }
                        stop => { root.command("stop-config"); }
                        build => { root.command("make"); }
                        test => { root.command("make"); }
                        settings => { root.command("dialog:settings"); }
                    }

                    WindowControls {
                        minimizable: true;
                        maximizable: true;
                        maximized <=> root.maximized;
                        minimize => { root.minimized = true; }
                        maximize => { root.maximized = !root.maximized; }
                        quit => { root.close(); }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Tabs + breadcrumb ────────────────────────────────────────────
        TabStrip {
            tabs: root.tabs;
            selected(i) => { root.tab-clicked(i); }
            closed(i) => { root.tab-closed(i); }
        }

        Breadcrumb { segments: root.breadcrumbs; visible: root.breadcrumb-enabled; }

        // ── Rail + left dock + editor + right dock ───────────────────────
        HorizontalLayout {
            ToolRail {
                active: root.active-rail;
                debug-active: root.debug-phase != "none";
                selected(i) => { root.rail-selected(i); }
            }

            if root.active-rail == 0 && root.sidebar-open : ProjectTree {
                width: root.sidebar-width;
                title: root.tree-title;
                rows: root.tree;
                selected-path: root.selected-path;
                empty-message: root.tree-empty;
                activated(path) => { root.tree-clicked(path); }
                refresh => { root.sidebar-refresh(); }
                collapse => { root.sidebar-collapse(); }
            }

            if root.active-rail == 1 && root.sidebar-open : CommitPanel {
                width: root.sidebar-width;
                has-repo: root.vc-has-repo;
                repo-label: root.vc-repo-label;
                branch: root.vc-branch;
                branches: root.vc-branches;
                has-staging: root.vc-has-staging;
                staged: root.staged-changes;
                unstaged: root.unstaged-changes;
                untracked: root.untracked-changes;
                conflicts: root.conflict-changes;
                busy: root.vc-busy;
                error-banner: root.vc-error;
                message <=> root.commit-message;
                amend <=> root.commit-amend;
                change-clicked(path) => { root.change-clicked(path); }
                stage-clicked(path, staged) => { root.stage-clicked(path, staged); }
                discard-clicked(path) => { root.discard-clicked(path); }
                resolve-clicked(path, ours) => { root.resolve-clicked(path, ours); }
                branch-changed(b) => { root.branch-changed(b); }
                commit => { root.commit(); }
                command(cmd) => { root.command(cmd); }
            }

            if root.active-rail == 2 && root.sidebar-open : DebuggerPanel {
                width: root.sidebar-width;
                phase: root.debug-phase;
                status-text: root.debug-status;
                adapter: root.debug-adapter;
                can-resume: root.debug-can-resume;
                can-pause: root.debug-can-pause;
                can-step: root.debug-can-step;
                can-stop: root.debug-can-stop;
                can-restart: root.debug-can-restart;
                frames: root.debug-frames;
                variables: root.debug-vars;
                watches: root.debug-watches;
                breakpoints: root.debug-breakpoints;
                console: root.debug-console;
                console-total: root.debug-console-total;
                watch-draft <=> root.debug-watch-draft;
                command(cmd) => { root.debug-cmd(cmd); }
                select-frame(id) => { root.debug-frame-selected(id); }
                toggle-expand(r) => { root.debug-toggle-expand(r); }
                watch-add() => { root.debug-watch-add(); }
                watch-remove(expr) => { root.debug-watch-remove(expr); }
                bp-toggle(f, l, on) => { root.debug-bp-toggle(f, l, on); }
                bp-remove(f, l) => { root.debug-bp-remove(f, l); }
                bp-open(f, l) => { root.debug-bp-open(f, l); }
            }

            // Drag handle: resize the left dock between the rail and editor.
            if root.sidebar-open : Rectangle {
                width: 5px;
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        root.sidebar-resized(self.pressed-x - self.mouse-x);
                    }
                }
            }

            editor-pane := EditorView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-width: 120px;
                    max-width: 100000px;
                    pane: root.pane;
                    pane-width: root.pane-width;
                    pane-height: root.pane-height;
                    pane-message: root.pane-message;
                    minimap: root.minimap;
                    minimap-visible: root.minimap-visible;
                    gutter: root.gutter;
                    gutter-visible: root.gutter-visible;
                    gutter-width: root.gutter-width;
                    cursor-x: root.cursor-x;
                    cursor-y: root.cursor-y;
                    cursor-height: root.cursor-height;
                    caret-visible: root.caret-visible;
                    caret-color: root.caret-color;
                    key(text, ctrl, shift, alt, meta) => {
                        root.key(text, ctrl, shift, alt, meta);
                    }
                mouse-pressed-left(x, y, ctrl, shift, alt, meta) => {
                    root.mouse-pressed-left(x, y, ctrl, shift, alt, meta);
                }
                mouse-pressed-right(x, y) => {
                    root.mouse-pressed-right(x, y);
                }
                mouse-pressed-middle(x, y) => {
                    root.mouse-pressed-middle(x, y);
                }
                mouse-moved(x, y) => {
                    root.mouse-moved(x, y);
                }
                mouse-hover(x, y) => {
                    root.mouse-hover(x, y);
                }
                mouse-released() => {
                    root.mouse-released();
                }
                mouse-scrolled(x, y, dx, dy, ctrl, shift, alt, meta) => {
                    root.mouse-scrolled(x, y, dx, dy, ctrl, shift, alt, meta);
                }
                ime-committed(text) => {
                    root.ime-committed(text);
                }
            }

            // Drag handle: resize the right tool column (Agent, Database).
            if root.agent-open || root.db-open : Rectangle {
                width: 5px;
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        // The handle follows the pointer, so the unapplied
                        // remainder is the current press offset (same pattern
                        // as Slint's table column resizer).
                        root.agent-resized(self.pressed-x - self.mouse-x);
                    }
                }
            }

            if root.agent-open : AgentDock {
                width: root.agent-dock-width;
                entries: root.agent-entries;
                sessions: root.agent-sessions;
                running: root.agent-running;
                configured: root.agent-configured;
                providers: root.agent-providers;
                models: root.agent-models;
                provider <=> root.agent-provider;
                model <=> root.agent-model;
                turns-left: root.agent-turns-left;
                prompt <=> root.agent-prompt;
                entry-count: root.agent-entries.length;
                phase: root.agent-phase;
                phase-detail: root.agent-phase-detail;
                approval-summary: root.agent-approval-summary;
                files: root.agent-files;
                submit => { root.agent-submit(); }
                stop => { root.agent-stop(); }
                approve => { root.agent-approve(); }
                decline => { root.agent-decline(); }
                open-file(p) => { root.agent-open-file(p); }
                select-session(id) => { root.agent-select-session(id); }
                toggle-expanded(idx) => { root.agent-toggle-expanded(idx); }
                provider-changed(v) => { root.agent-provider-changed(v); }
                open-settings => { root.agent-open-settings(); }
            }

            // Vertical handle between the Agent dock and the Database tool.
            if root.agent-open && root.db-open : Rectangle {
                height: 5px;
                TouchArea {
                    mouse-cursor: ns-resize;
                    moved => {
                        root.db-resized(self.pressed-y - self.mouse-y);
                    }
                }
            }

            if root.db-open && root.agent-open : DatabasePanel {
                height: root.db-height;
                width: root.agent-dock-width;
                sources: root.db-sources;
                active-source: root.db-active-source;
                connected: root.db-connected;
                connected-label: root.db-connected-label;
                busy: root.db-busy;
                tree: root.db-tree;
                columns: root.db-columns;
                rows: root.db-rows;
                status: root.db-status;
                status-error: root.db-status-error;
                truncated: root.db-truncated;
                row-count: root.db-row-count;
                elapsed: root.db-elapsed;
                source-changed(v) => { root.db-source-changed(v); }
                connect-toggle => { root.db-connect-toggle(); }
                refresh => { root.db-refresh-schema(); }
                form-opened => { root.db-form-opened(); }
                open-console => { root.db-open-console(); }
                toggle-table(i) => { root.db-toggle-table(i); }
                table-opened(i) => { root.db-table-opened(i); }
                run => { root.db-run-query(); }
                cancel-query => { root.db-cancel-query(); }
            }
            if root.db-open && !root.agent-open : DatabasePanel {
                vertical-stretch: 1;
                width: root.agent-dock-width;
                sources: root.db-sources;
                active-source: root.db-active-source;
                connected: root.db-connected;
                connected-label: root.db-connected-label;
                busy: root.db-busy;
                tree: root.db-tree;
                columns: root.db-columns;
                rows: root.db-rows;
                status: root.db-status;
                status-error: root.db-status-error;
                truncated: root.db-truncated;
                row-count: root.db-row-count;
                elapsed: root.db-elapsed;
                source-changed(v) => { root.db-source-changed(v); }
                connect-toggle => { root.db-connect-toggle(); }
                refresh => { root.db-refresh-schema(); }
                form-opened => { root.db-form-opened(); }
                open-console => { root.db-open-console(); }
                toggle-table(i) => { root.db-toggle-table(i); }
                table-opened(i) => { root.db-table-opened(i); }
                run => { root.db-run-query(); }
                cancel-query => { root.db-cancel-query(); }
            }

            RightRail {
                agent-open: root.agent-open;
                db-open: root.db-open;
                agent-toggled => { root.agent-toggle(); }
                db-toggled => { root.db-toggle(); }
            }
        }

        // ── Bottom dock + bar ────────────────────────────────────────────
        if root.bottom-tool >= 0 : BottomDock {
            tool: root.bottom-tool;
            dock-height: root.dock-height;
            title: root.bottom-title;
            terminal-text: root.terminal-text;
            terminal-image: root.terminal-image;
            terminal-sessions: root.terminal-sessions;
            terminal-active: root.terminal-active;
            find-rows: root.find-rows;
            output-title: root.output-title;
            output-text: root.output-text;
            output-follow: root.output-follow;
            problems: root.problems;
            git-history: root.git-history;
            close => { root.close-bottom(); }
            resized(d) => { root.dock-resized(d); }
            resize-reset => { root.dock-resize-reset(); }
            terminal-new => { root.terminal-new(); }
            terminal-focus(i) => { root.terminal-focus(i); }
            terminal-close(i) => { root.terminal-close(i); }
            terminal-scroll(d) => { root.terminal-scroll(d); }
            find-open(path, line) => { root.find-open(path, line); }
            output-clear => { root.output-clear(); }
            output-toggle-follow => { root.output-toggle-follow(); }
        }

        if root.progress-tasks.length > 0 : ProgressStrip {
            tasks: root.progress-tasks;
        }

        BottomBar {
            active: root.bottom-tool;
            problems-count: root.bottom-problems-count;
            terminal-count: root.bottom-terminal-count;
            toggle(i) => { root.toggle-bottom(i); }
        }

        // ── Status bar ───────────────────────────────────────────────────
        StatusBar {
            file: root.status-file;
            modified: root.status-modified;
            message: root.status-message;
            message-error: root.status-error;
            branch: root.status-branch;
            position: root.status-position;
            mode: root.status-mode;
            encoding: root.status-encoding;
        }
    }

    // Click-away layer for the open menu.
    if root.menu-visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.menu-visible = false; }
        }
    }

    if root.menu-visible : MenuPopup {
        x: root.menu-x;
        y: Theme.menu-height;
        items: root.menu-items;
        activated(cmd) => {
            root.menu-visible = false;
            root.command(cmd);
        }
    }

    // ── Settings overlay ─────────────────────────────────────────────────
    if root.settings-visible : SettingsView {
        rows: root.settings-rows;
        plugin-rows: root.settings-plugin-rows;
        settings-category <=> root.settings-category;
        settings-search <=> root.settings-search;
        settings-app-font-name <=> root.settings-app-font-name;
        settings-app-font-size <=> root.settings-app-font-size;
        settings-editor-font-name <=> root.settings-editor-font-name;
        settings-editor-font-size <=> root.settings-editor-font-size;
        settings-ligatures <=> root.settings-ligatures;
        settings-agent-provider <=> root.settings-agent-provider;
        settings-agent-token <=> root.settings-agent-token;
        settings-agent-model <=> root.settings-agent-model;
        available-fonts: root.available-fonts;
        agent-models: root.agent-models;
        agent-configured: root.agent-configured;
        set-option(name, v) => { root.set-option(name, v); }
        reset-option(name) => { root.reset-option(name); }
        add-option(name, v) => { root.add-option(name, v); }
        plugin-toggled(n, c) => { root.plugin-toggled(n, c); }
        search-changed() => { root.settings-search-changed(); }
        select-category(c) => { root.settings-select-category(c); }
        apply-font-settings => { root.apply-font-settings(); }
        apply-agent-settings => { root.apply-agent-settings(); }
        close => { root.settings-visible = false; }
        command(cmd) => { root.command(cmd); }
    }

    // ── Database connection dialog ───────────────────────────────────────
    if root.db-form-open : Rectangle {
        background: #00000066;

        // Backdrop click dismisses, like the other dialogs.
        TouchArea { clicked => { root.db-form-cancelled(); } }

        Rectangle {
            width: 400px;
            height: dlg.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.chrome;
            border-radius: Theme.radius-pill;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000077;
            drop-shadow-offset-y: 6px;

            dlg := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "New Database Connection";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.db-form-note;
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 160px;
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Name"; color: Theme.text-faint; font-size: 10px; font-weight: 600; }
                    Field {
                        placeholder: "e.g. app-db";
                        text <=> root.db-form-name;
                        accepted => { root.db-source-created(root.db-form-name, root.db-form-path); }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    Text { text: "SQLite database file"; color: Theme.text-faint; font-size: 10px; font-weight: 600; }
                    Field {
                        placeholder: "/path/to/database.sqlite";
                        text <=> root.db-form-path;
                        accepted => { root.db-source-created(root.db-form-name, root.db-form-path); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    DialogButton { label: "Test"; clicked => { root.db-test-connection(root.db-form-name, root.db-form-path); } }
                    DialogButton { label: "Add and Connect"; primary: true;
                        clicked => { root.db-source-created(root.db-form-name, root.db-form-path); } }
                    DialogButton { label: "Cancel"; clicked => { root.db-form-cancelled(); } }
                }
            }
        }
    }

    // ── Dialog overlay ───────────────────────────────────────────────────
    if root.dialog-visible : DialogView {
        dialog-title: root.dialog-title;
        dialog-input <=> root.dialog-input;
        command(cmd) => { root.command(cmd); }
        close => { root.dialog-visible = false; }
    }

    // ── Quit confirmation overlay ────────────────────────────────────────
    if root.quit-confirm-visible : QuitView {
        message: root.quit-confirm-message;
        files: root.quit-confirm-files;
        command(cmd) => { root.command(cmd); }
    }

    // ── New Project wizard overlay ───────────────────────────────────────
    if root.new-project-visible : NewProjectView {
        solo: root.new-project-solo;
        templates: root.new-project-templates;
        detail: root.new-project-detail;
        languages: root.new-project-languages;
        language: root.new-project-language;
        vars: root.new-project-vars;
        search <=> root.new-project-search;
        project-name <=> root.new-project-name;
        dest-dir <=> root.new-project-dest;
        note: root.new-project-note;
        create-reason: root.new-project-create-reason;
        can-create: root.new-project-can-create;
        generating: root.new-project-generating;
        close() => { root.command("new-project:close"); }
        create() => { root.command("new-project:create"); }
        browse() => { root.command("new-project:browse"); }
        select(i) => { root.command("new-project:select:" + i); }
        language-select(i) => { root.command("new-project:language:" + i); }
        move-selection(d) => { root.command("new-project:move:" + d); }
        search-changed() => { root.command("new-project:search-changed"); }
        var-changed(key, value) => { root.command("new-project:var:" + key + "=" + value); }
        name-changed() => { root.command("new-project:name-changed"); }
        dest-changed() => { root.command("new-project:dest-changed"); }
    }

    // ── Hover card / completion popup / quickfix menu ────────────────────
    // These coordinates are editor-view-relative (the shell computes them
    // from cell metrics); editor-pane.absolute-position converts them to
    // window coordinates so the popups track the caret.
    if root.hover-visible : HoverCard {
        hover-x: editor-pane.absolute-position.x + root.hover-x;
        hover-y: editor-pane.absolute-position.y + root.hover-y;
        hover-lines: root.hover-lines;
    }

    if root.completion-visible : CompletionPopup {
        completion-x: editor-pane.absolute-position.x + root.completion-x;
        completion-y: editor-pane.absolute-position.y + root.completion-y;
        completion-entries: root.completion-entries;
        completion-selected: root.completion-selected;
        completion-info: root.completion-info;
    }

    if root.quickfix-visible : QuickfixMenu {
        quickfix-x: editor-pane.absolute-position.x + root.quickfix-x;
        quickfix-y: editor-pane.absolute-position.y + root.quickfix-y;
        quickfix-items: root.quickfix-items;
        quickfix-selected: root.quickfix-selected;
    }

    // ── Frameless-window resize zones ─────────────────────────────────────
    WindowResizeEdges {
        begin(dir) => { root.window-resize-begin(dir); }
        drag(dir, dx, dy) => { root.window-resize-move(dir, dx, dy); }
    }
}
