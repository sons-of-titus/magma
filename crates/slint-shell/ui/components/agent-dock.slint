import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ToolWindowHeader, Field, Picker } from "controls.slint";
import { ToolbarIcon as IconButton } from "button.slint";

// One transcript row, projected from the kernel session.
export struct AgentEntry {
    kind: string,      // user | thought | action | output | result | error
    text: string,
    detail: string,    // action: the tool/command name
    status: string,    // action: running | ok | error | planned
    expanded: bool,
    idx: int,          // transcript index for expansion callbacks; -1 otherwise
}

export struct AgentSessionChip {
    id: int,
    status: string,    // running | completed | failed
    selected: bool,
}

component EntryRow inherits Rectangle {
    in property <AgentEntry> entry;
    callback toggle(int);

    VerticalLayout {
        spacing: 4px;

        // ── User prompt: quiet filled block ─────────────────────────────
        if entry.kind == "user" : Rectangle {
            height: user-text.preferred-height + 14px;
            border-radius: Theme.radius;
            background: Theme.fill-muted;

            HorizontalLayout {
                padding: 7px;
                spacing: 8px;

                Rectangle { width: 3px; border-radius: 2px; background: Theme.accent; }

                user-text := Text {
                    text: entry.text;
                    color: Theme.text-primary;
                    font-size: Theme.font-ui;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

        // ── Agent prose ──────────────────────────────────────────────────
        if entry.kind == "thought" : HorizontalLayout {
            spacing: 8px;
            Text {
                width: 14px;
                text: "✦";
                color: Theme.text-faint;
                font-size: Theme.font-small;
                vertical-alignment: top;
            }
            Text {
                text: entry.text;
                color: Theme.text-secondary;
                font-size: Theme.font-ui;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        // ── Tool call card: status glyph, name, summary, expandable output
        if entry.kind == "action" : VerticalLayout {
            spacing: 4px;

            Rectangle {
                height: 24px;
                border-radius: Theme.radius;
                background: action-touch.has-hover ? Theme.fill-muted : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        width: entry.expanded ? 12px : 10px;
                        text: entry.expanded ? "▾" : (entry.status == "ok" || entry.status == "error" ? "▸" : "");
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        width: 13px;
                        text: entry.status == "ok" ? "✓"
                            : entry.status == "error" ? "✕"
                            : entry.status == "running" ? "●"
                            : "○";
                        color: entry.status == "ok" ? Theme.success
                            : entry.status == "error" ? Theme.danger
                            : entry.status == "running" ? Theme.accent
                            : Theme.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        width: detail-text.preferred-width + 2px;
                        text: entry.detail;
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    detail-text := Text {
                        horizontal-stretch: 1;
                        text: entry.text;
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if entry.status == "running" : Text {
                        text: "running";
                        color: Theme.accent;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    if entry.status == "planned" : Text {
                        text: "planned";
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                action-touch := TouchArea {
                    enabled: entry.status == "ok" || entry.status == "error";
                    mouse-cursor: pointer;
                    clicked => { root.toggle(entry.idx); }
                }
            }

            // The tool's output, revealed on expand.
            if entry.expanded && entry.text != "" : Rectangle {
                height: out-text.preferred-height + 16px;
                border-radius: Theme.radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                out-text := Text {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    text: entry.text;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

        // ── Standalone output block (legacy shape) ───────────────────────
        if entry.kind == "output" : Rectangle {
            height: solo-text.preferred-height + 12px;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            solo-text := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: entry.text;
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 11px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        // ── Final result ─────────────────────────────────────────────────
        if entry.kind == "result" : HorizontalLayout {
            spacing: 8px;
            Text {
                width: 14px;
                text: "✓";
                color: Theme.success;
                font-size: Theme.font-small;
                vertical-alignment: top;
            }
            Text {
                text: entry.text;
                color: Theme.text-primary;
                font-size: Theme.font-ui;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        // ── Error ────────────────────────────────────────────────────────
        if entry.kind == "error" : Rectangle {
            height: err-text.preferred-height + 12px;
            border-radius: Theme.radius;
            background: Theme.danger.transparentize(0.92);

            HorizontalLayout {
                padding: 6px;
                padding-left: 8px;
                spacing: 8px;

                Text {
                    width: 13px;
                    text: "✕";
                    color: Theme.danger;
                    font-size: 11px;
                    vertical-alignment: top;
                }
                err-text := Text {
                    text: entry.text;
                    color: Theme.danger;
                    font-size: Theme.font-ui;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
    }
}

component SessionChip inherits Rectangle {
    in property <AgentSessionChip> chip;
    callback selected(int);

    height: 20px;
    width: chip-label.preferred-width + 22px;
    border-radius: Theme.radius-pill;
    background: chip.selected ? Theme.fill : (chip-touch.has-hover ? Theme.fill-muted : transparent);
    border-width: 1px;
    border-color: chip.selected ? Theme.border : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;

        Text {
            text: chip.status == "running" ? "●" : chip.status == "failed" ? "✕" : "✓";
            color: chip.status == "running" ? Theme.accent
                : chip.status == "failed" ? Theme.danger
                : Theme.success;
            font-size: 9px;
            vertical-alignment: center;
        }
        chip-label := Text {
            text: "Session " + chip.id;
            color: chip.selected ? Theme.text-primary : Theme.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(chip.id); }
    }
}

export component AgentDock inherits Rectangle {
    // ── Bound to shell state ─────────────────────────────────────────────
    in property <[AgentEntry]> entries;
    in property <[AgentSessionChip]> sessions;
    in property <bool> running: false;
    in property <bool> configured: false;
    in property <[string]> providers;
    in property <[string]> models;
    in-out property <string> provider;
    in-out property <string> model;
    in-out property <string> prompt;
    in property <int> entry-count: 0;
    in property <int> turns-left: 0;

    // ── Callbacks ────────────────────────────────────────────────────────
    callback submit();
    callback stop();
    callback select-session(int);
    callback toggle-expanded(int);
    callback provider-changed(string);
    callback open-settings();

    width: 380px;
    background: Theme.surface-panel;

    // Auto-scroll: follow the tail while the user sits near the bottom.
    property <bool> follow: true;

    function reveal-latest() {
        scroll.content-y = scroll.content-height - feed.preferred-height;
    }

    public function jump-to-latest() {
        root.follow = true;
        root.reveal-latest();
    }

    VerticalLayout {
        // ── Header ───────────────────────────────────────────────────────
        HorizontalLayout {
            ToolWindowHeader {
                horizontal-stretch: 1;
                title: "Agent";
                glyph: "\u{EC20}";
                status-text: root.running
                    ? "working · " + root.turns-left + " turns left"
                    : root.sessions.length > 0
                        ? root.sessions[root.sessions.length - 1].status
                        : root.configured ? "ready" : "not configured";
                status-tint: root.running ? Theme.accent
                    : root.sessions.length > 0 && root.sessions[root.sessions.length - 1].status == "failed"
                        ? Theme.danger
                    : root.sessions.length > 0 ? Theme.success
                    : root.configured ? Theme.success : Theme.text-faint;
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                glyph: "⚙";
                clicked => { root.open-settings(); }
            }
        }

        // ── Session chips (only when there is history) ───────────────────
        if root.sessions.length > 1 : Rectangle {
            height: 28px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: start;
                for chip in root.sessions : SessionChip {
                    chip: chip;
                    selected(id) => { root.select-session(id); }
                }
            }
        }

        // ── Unconfigured banner ──────────────────────────────────────────
        if !root.configured : Rectangle {
            height: 40px;
            background: Theme.warning.transparentize(0.90);

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: "No API key for " + root.provider + ". Add one to start the agent.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 92px;
                    height: 22px;
                    border-radius: Theme.radius;
                    background: configure-touch.has-hover ? Theme.fill-strong : Theme.fill;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: "Open Settings";
                        color: Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    configure-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-settings(); }
                    }
                }
            }
        }

        // ── Transcript ───────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            scroll := ScrollView {
                width: 100%;
                height: 100%;

                feed := VerticalLayout {
                    padding: 10px;
                    padding-bottom: 18px;
                    spacing: 8px;

                    if root.entry-count == 0 : VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        padding-top: 40px;
                        Text {
                            text: "\u{EC20}";
                            color: Theme.text-faint;
                            font-family: "Symbols Nerd Font";
                            font-size: 26px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Ask the agent to work alongside you";
                            color: Theme.text-secondary;
                            font-size: Theme.font-ui;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            width: root.width - 48px;
                            x: 24px;
                            text: "It can read the active buffer, inspect diagnostics, and run editor commands — each step is shown below.";
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    for entry[i] in root.entries : EntryRow {
                        entry: entry;
                        toggle(idx) => { root.toggle-expanded(idx); }
                    }
                }

                changed content-y => {
                    root.follow = self.content-y >= Math.min(0px, scroll.content-height - feed.preferred-height) + 24px;
                }
            }

            // Return-to-latest affordance while reading history mid-run.
            if !root.follow && root.running : Rectangle {
                x: (parent.width - 92px) / 2;
                y: parent.height - 30px;
                width: 92px;
                height: 22px;
                border-radius: Theme.radius-pill;
                background: Theme.fill-strong;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000044;

                Text {
                    text: "↓ latest";
                    color: Theme.text-primary;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.jump-to-latest(); }
                }
            }
        }

        // ── Composer ─────────────────────────────────────────────────────
        Rectangle {
            background: Theme.chrome;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;

                    Field {
                        horizontal-stretch: 1;
                        placeholder: "Ask the agent…";
                        text <=> root.prompt;
                        accepted => {
                            root.follow = true;
                            root.submit();
                        }
                    }

                    Rectangle {
                        width: root.running ? 74px : 60px;
                        height: Theme.control-height;
                        border-radius: Theme.radius;
                        background: root.running
                            ? (stop-touch.has-hover ? Theme.danger.darker(0.15) : Theme.danger)
                            : (root.prompt == "" || !root.configured
                                ? Theme.fill-muted
                                : (send-touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent));

                        Text {
                            text: root.running ? "■ Stop" : "Send";
                            color: root.running ? white
                                : (root.prompt == "" || !root.configured ? Theme.text-faint : white);
                            font-size: Theme.font-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        stop-touch := TouchArea {
                            visible: root.running;
                            enabled: root.running;
                            mouse-cursor: pointer;
                            clicked => { root.stop(); }
                        }
                        send-touch := TouchArea {
                            visible: !root.running;
                            enabled: root.prompt != "" && root.configured;
                            mouse-cursor: pointer;
                            clicked => {
                                root.follow = true;
                                root.submit();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Picker {
                        choices: root.providers;
                        current-value <=> root.provider;
                        min-width: 96px;
                        changed(v) => { root.provider-changed(v); }
                    }

                    Picker {
                        choices: root.models;
                        current-value <=> root.model;
                        min-width: 130px;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }

    changed entry-count => {
        if root.follow {
            root.reveal-latest();
        }
    }
}
