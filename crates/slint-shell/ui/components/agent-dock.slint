import { Theme } from "../theme.slint";
import { AgentOnboarding, ProviderCard, AuthPanelView } from "agent-onboarding.slint";
import { PickerChoice } from "agent-composer.slint";
import { AgentConversation, AgentEntry, AgentSessionChip } from "agent-conversation.slint";

// The Agent tool window: the provider onboarding screen *replaces* the
// conversation until a provider is connected — there is no chat UI to show
// without one.  Once connected, the same screen doubles as the connection
// manager via `manage-open`, leaving the conversation untouched underneath.
export component AgentDock inherits Rectangle {
    // ── Transcript state ─────────────────────────────────────────────────
    in property <[AgentEntry]> entries;
    in property <[AgentSessionChip]> sessions;
    in property <bool> running: false;
    in property <int> entry-count: 0;
    in property <string> phase: "ready";
    in property <string> phase-detail: "";
    in property <string> approval-summary: "";
    in property <[string]> files;
    in property <int> turns-left: 0;
    in property <int> turns-total: 12;

    // ── Connection state ─────────────────────────────────────────────────
    in property <bool> connected: false;
    in property <[ProviderCard]> provider-cards;
    in property <bool> auth-active: false;
    in property <AuthPanelView> auth;
    in-out property <bool> manage-open: false;

    // ── Composer state ───────────────────────────────────────────────────
    in-out property <string> prompt;
    in property <[string]> attachments;
    in property <PickerChoice> provider;
    in property <[PickerChoice]> provider-choices;
    in property <PickerChoice> model;
    in property <[PickerChoice]> model-choices;
    in property <bool> reasoning-supported: false;
    in property <string> reasoning-label: "";
    in property <[PickerChoice]> reasoning-choices;
    in property <string> send-blocked-reason: "";

    // ── Callbacks ────────────────────────────────────────────────────────
    callback submit();
    callback stop();
    callback approve();
    callback decline();
    callback select-session(int);
    callback toggle-expanded(int);
    callback open-file(string);
    callback connect-provider(string);
    callback disconnect-provider(string);
    callback submit-key(string);
    callback open-url(string);
    callback copy-code();
    callback onboarding-back();
    callback provider-selected(string);
    callback model-changed(string);
    callback reasoning-changed(string);
    callback attach-active-buffer();
    callback attach-file();
    callback attach-remove(int);
    callback manage-providers();

    width: 340px;
    background: Theme.surface-panel;

    property <bool> onboarding-visible: !root.connected || root.manage-open;

    // ── Onboarding / connection manager: the whole dock ──────────────────
    if root.onboarding-visible : AgentOnboarding {
        cards: root.provider-cards;
        auth-active: root.auth-active;
        auth: root.auth;
        manage-mode: root.connected;
        connect-provider(id) => { root.connect-provider(id); }
        disconnect-provider(id) => { root.disconnect-provider(id); }
        submit-key(k) => { root.submit-key(k); }
        open-url(u) => { root.open-url(u); }
        copy-code => { root.copy-code(); }
        back => {
            root.manage-open = false;
            root.onboarding-back();
        }
    }

    // ── Conversation ─────────────────────────────────────────────────────
    if !root.onboarding-visible : AgentConversation {
        entries: root.entries;
        sessions: root.sessions;
        running: root.running;
        entry-count: root.entry-count;
        phase: root.phase;
        phase-detail: root.phase-detail;
        approval-summary: root.approval-summary;
        files: root.files;
        turns-left: root.turns-left;
        turns-total: root.turns-total;

        prompt <=> root.prompt;
        attachments: root.attachments;
        provider: root.provider;
        provider-choices: root.provider-choices;
        model: root.model;
        model-choices: root.model-choices;
        reasoning-supported: root.reasoning-supported;
        reasoning-label: root.reasoning-label;
        reasoning-choices: root.reasoning-choices;
        send-blocked-reason: root.send-blocked-reason;

        submit => { root.submit(); }
        stop => { root.stop(); }
        approve => { root.approve(); }
        decline => { root.decline(); }
        select-session(id) => { root.select-session(id); }
        toggle-expanded(idx) => { root.toggle-expanded(idx); }
        open-file(p) => { root.open-file(p); }
        provider-selected(id) => { root.provider-selected(id); }
        model-changed(id) => { root.model-changed(id); }
        reasoning-changed(v) => { root.reasoning-changed(v); }
        attach-active-buffer => { root.attach-active-buffer(); }
        attach-file => { root.attach-file(); }
        attach-remove(i) => { root.attach-remove(i); }
        manage-providers => { root.manage-open = true; }
    }
}
