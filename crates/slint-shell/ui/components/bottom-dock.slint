import { Theme } from "../theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Button, ToolbarIcon } from "button.slint";
import { EmptyState } from "tool-window.slint";

export struct FindRow {
    title: string,
    detail: string,
    path: string,
    line: int,
}

export struct ProblemRow {
    severity: string,   // error | warning | info
    message: string,
    location: string,   // "file:line:col", already formatted
    path: string,
    line: int,
}

export struct GitHistoryRow {
    hash: string,
    author: string,
    date: string,
    message: string,
}

// One rendered line of task output; `path`/`line` are set when the line
// carries a `file:line:col` location, making it a clickable jump.
export struct OutputLine {
    text: string,
    path: string,
    line: int,
}

component DockButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <int> count: -1;
    in property <bool> active: false;
    callback clicked();

    height: 22px;
    width: label-text.preferred-width + 30px + (root.count >= 0 ? 30px : 0px);
    border-radius: Theme.radius;
    background: active ? Theme.fill : (touch.has-hover ? Theme.fill-muted : transparent);

    Text {
        x: 7px;
        width: 16px;
        text: root.glyph;
        color: root.active ? Theme.text-primary : Theme.text-faint;
        font-family: "Symbols Nerd Font";
        font-size: 13px;
        vertical-alignment: center;
    }

    label-text := Text {
        x: 25px;
        text: root.label;
        color: root.active ? Theme.text-primary : Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }

    if root.count >= 0 : Rectangle {
        x: label-text.x + label-text.preferred-width + 6px;
        y: (root.height - 14px) / 2;
        width: 24px;
        height: 14px;
        border-radius: 7px;
        background: root.active ? Theme.fill-strong : Theme.fill-muted;
        count-text := Text {
            text: root.count;
            color: Theme.text-muted;
            font-size: 9px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BottomBar inherits Rectangle {
    in property <int> active: 0;
    in property <int> problems-count: 0;
    in property <int> terminal-count: 0;
    callback toggle(int);

    height: 26px;
    background: Theme.surface-panel;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 2px;
        alignment: start;

        DockButton {
            glyph: "\u{EA85}";
            label: "Terminal";
            count: root.terminal-count > 0 ? root.terminal-count : -1;
            active: root.active == 0;
            clicked => { root.toggle(0); }
        }
        DockButton {
            glyph: "\u{F0279}";
            label: "Output";
            active: root.active == 2;
            clicked => { root.toggle(2); }
        }
        DockButton {
            glyph: "\u{EB0C}";
            label: "Problems";
            count: root.problems-count;
            active: root.active == 4;
            clicked => { root.toggle(4); }
        }
        DockButton {
            glyph: "\u{EA6D}";
            label: "Search";
            active: root.active == 1;
            clicked => { root.toggle(1); }
        }
        DockButton {
            glyph: "\u{F062C}";
            label: "Git";
            active: root.active == 3;
            clicked => { root.toggle(3); }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}

component TerminalTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback selected();
    callback closed();

    height: 26px;
    width: Math.max(104px, label-text.preferred-width + 44px);
    background: active ? Theme.tab-active : ((touch.has-hover || close-touch.has-hover) ? Theme.tab-hover : transparent);
    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;

    touch := TouchArea {
        width: root.width - 24px;
        height: root.height;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    label-text := Text {
        x: 10px;
        width: Math.max(0px, root.width - 38px);
        text: root.label;
        color: root.active ? Theme.text-primary : ((touch.has-hover || close-touch.has-hover) ? Theme.text-primary : Theme.text-muted);
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: root.width - 24px;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius;
        opacity: (root.active || touch.has-hover || close-touch.has-hover) ? 1.0 : 0.0;
        background: close-touch.has-hover ? Theme.danger : transparent;

        Text {
            text: "×";
            color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.active || touch.has-hover || close-touch.has-hover {
                    root.closed();
                }
            }
        }
    }
}

export component TerminalView inherits Rectangle {
    in property <string> text;
    in property <image> image;
    in property <[string]> sessions;
    in property <int> active-session: 0;
    in-out property <string> input;
    callback new-session();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);
    callback terminal-send(string);

    background: Theme.surface;

    property <length> tabs-h: sessions.length > 0 ? 26px : 0px;
    property <length> input-h: 26px;
    property <length> body-h: Math.floor((root.height - self.tabs-h - root.input-h) / 20px) * 20px;

    // ── Session tabs ────────────────────────────────────────────────────
    if sessions.length > 0 : Rectangle {
        y: 0;
        height: 26px;
        background: Theme.chrome;
        clip: true;

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.fill-muted;
        }

        HorizontalLayout {
            padding-left: 4px;
            spacing: 0px;
            alignment: start;

            for s[i] in root.sessions : TerminalTab {
                label: s;
                active: i == root.active-session;
                selected => { root.terminal-focus(i); }
                closed => { root.terminal-close(i); }
            }
        }
    }

    if sessions.length == 0 : EmptyState {
        glyph: "\u{EA85}";
        title: "No terminal session";
        detail: "Start one to use the shell.";
        action-label: "Start Terminal";
        action => { root.new-session(); }
    }

    if image.width > 0 : Image {
        y: root.tabs-h;
        width: 100%;
        height: root.body-h;
        source: root.image;
        image-fit: fill;
        image-rendering: smooth;
    }

    if image.width > 0 : TouchArea {
        y: root.tabs-h;
        width: 100%;
        height: root.body-h;
        clicked => { term-input.focus(); }
        scroll-event(event) => {
            root.terminal-scroll(event.delta-y);
            accept
        }
    }

    ScrollView {
        visible: root.text != "" && image.width == 0;
        y: root.tabs-h;
        height: root.body-h;
        Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: 11px;
            wrap: no-wrap;
        }
    }

    // ── Input line: typing goes to the session's PTY ─────────────────────
    Rectangle {
        y: root.height - root.input-h;

        init => { term-input.focus(); }
        height: root.input-h;
        background: Theme.chrome;

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;

            Text {
                width: 12px;
                text: sessions.length == 0 ? "" : "❯";
                color: Theme.text-faint;
                font-size: Theme.font-ui;
                vertical-alignment: center;
            }

            Rectangle {
                height: 20px;
                y: (parent.height - 20px) / 2;
                border-radius: Theme.radius;
                background: term-input.has-focus ? Theme.surface : transparent;
                border-width: 1px;
                border-color: term-input.has-focus ? Theme.accent : transparent;
                horizontal-stretch: 1;

                term-input := TextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    text <=> root.input;
                    color: Theme.text-primary;
                    font-size: Theme.font-ui;
                    single-line: true;
                    enabled: sessions.length > 0;
                    accepted => {
                        root.terminal-send(root.input);
                        root.input = "";
                    }
                }
            }

            Text {
                text: sessions.length == 0 ? "start a session to send input" : "Enter sends · ⌃C to interrupt";
                color: Theme.text-faint;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}

export component FindView inherits Rectangle {
    in property <[FindRow]> rows;
    in-out property <string> query;
    in property <string> status-text: "";
    callback search(string);
    callback open(string, int);

    background: Theme.surface;

    VerticalLayout {
        // ── Query row ────────────────────────────────────────────────────
        Rectangle {
            height: 32px;
            background: Theme.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;

                Rectangle {
                    height: 24px;
                    y: 0;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border;
                    background: Theme.surface;
                    horizontal-stretch: 1;

                    search-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        text <=> root.query;
                        color: Theme.text-primary;
                        font-size: Theme.font-ui;
                        single-line: true;
                        accepted => { root.search(root.query); }
                    }

                    if root.query == "" && !search-input.has-focus : Text {
                        x: 6px;
                        text: "Search across project files — Enter to run";
                        color: Theme.text-faint;
                        font-size: Theme.font-ui;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.status-text;
                    color: Theme.text-faint;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }

            init => { search-input.focus(); }
        }

        // ── Results ──────────────────────────────────────────────────────
        if rows.length == 0 : Rectangle {
            vertical-stretch: 1;
            EmptyState {
                glyph: "\u{EA6D}";
                title: root.query == "" ? "Search the project" : "No matches";
                detail: root.query == ""
                    ? "Type a query above — every file in the project is searched."
                    : "Nothing in the project matches this query.";
            }
        }

        if rows.length > 0 : Rectangle {
            vertical-stretch: 1;
            ListView {
                for row[i] in root.rows : Rectangle {
                    height: 22px;
                    background: touch.has-hover ? Theme.fill-muted : transparent;

                    Text {
                        x: 8px;
                        text: row.title;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        width: root.width * 0.4;
                        overflow: elide;
                    }
                    Text {
                        x: root.width * 0.4 + 12px;
                        text: row.detail;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        overflow: elide;
                        width: root.width - self.x - 8px;
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open(row.path, row.line); }
                    }
                }
            }
        }
    }
}

export component ProblemsView inherits Rectangle {
    in property <[ProblemRow]> rows;
    callback open(string, int);

    background: Theme.surface;

    if rows.length == 0 : EmptyState {
        glyph: "\u{EB0C}";
        title: "No problems";
        detail: "Diagnostics from the language server and build tools land here.";
    }

    ListView {
        for row[i] in root.rows : Rectangle {
            height: 22px;
            background: touch.has-hover ? Theme.fill-muted : transparent;

            Text {
                x: 10px;
                width: 14px;
                text: row.severity == "warning" ? "▲"
                    : row.severity == "info" ? "ⓘ"
                    : "✕";
                color: row.severity == "warning" ? Theme.warning
                    : row.severity == "info" ? Theme.accent
                    : Theme.danger;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            Text {
                x: 30px;
                text: row.message;
                color: Theme.text-primary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
                width: Math.max(80px, root.width - Math.min(360px, row-location.preferred-width + 46px));
            }

            row-location := Text {
                x: root.width - self.preferred-width - 12px;
                text: row.location;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
                width: Math.min(340px, root.width * 0.4);
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open(row.path, row.line); }
            }
        }
    }
}

export component OutputView inherits Rectangle {
    in property <string> title;
    in property <[OutputLine]> lines;
    in property <bool> follow: true;
    callback clear();
    callback toggle-follow();
    callback open(string, int);

    background: Theme.surface;
    property <length> header-h: title == "" ? 0px : 28px;

    if title == "" && lines.length == 0 : EmptyState {
        glyph: "\u{F0279}";
        title: "No task output yet";
        detail: "Run, build, or test to fill this panel.";
    }

    // ── Task header: name, clear, follow ─────────────────────────────────
    if title != "" : Rectangle {
        y: 0;
        height: 28px;
        background: Theme.chrome;

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 6px;
            alignment: start;

            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            ToolbarIcon {
                y: (parent.height - self.height) / 2;
                glyph: root.follow ? "\u{F0045}" : "\u{F03E4}";
                symbol: true;
                tint: root.follow ? Theme.accent : Theme.text-muted;
                clicked => { root.toggle-follow(); }
            }
            ToolbarIcon {
                y: (parent.height - self.height) / 2;
                glyph: "∅";
                clicked => { root.clear(); }
            }
        }
    }

    ListView {
        y: root.header-h;
        height: root.height - root.header-h;
        width: 100%;

        changed content-height => {
            if root.follow && self.content-height > self.height {
                self.content-y = self.content-height - self.height;
            }
        }

        for line in root.lines : Rectangle {
            height: 16px;
            background: line.path != "" && row-touch.has-hover ? Theme.fill-muted : transparent;

            Text {
                x: 8px;
                width: parent.width - 16px;
                text: line.text;
                color: Theme.text-secondary;
                font-size: 11px;
                font-family: Theme.font-mono;
                wrap: no-wrap;
                vertical-alignment: center;
            }

            row-touch := TouchArea {
                enabled: line.path != "";
                mouse-cursor: line.path != "" ? pointer : default;
                clicked => { root.open(line.path, line.line); }
            }
        }
    }
}

export component HistoryView inherits Rectangle {
    in property <[GitHistoryRow]> rows;
    background: Theme.surface;

    if rows.length == 0 : EmptyState {
        glyph: "\u{F062C}";
        title: "No history";
        detail: "Open a repository to see commits.";
    }

    ListView {
        for row[i] in root.rows : Rectangle {
            height: 24px;
            background: touch.has-hover ? Theme.fill-muted : transparent;

            Text {
                x: 8px;
                width: 70px;
                text: row.hash;
                color: Theme.accent;
                font-size: Theme.font-small;
                font-family: Theme.font-mono;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 82px;
                width: 150px;
                text: row.author;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 236px;
                width: 120px;
                text: row.date;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 360px;
                width: root.width - 368px;
                text: row.message;
                color: Theme.text-primary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }

            touch := TouchArea { mouse-cursor: default; }
        }
    }
}

export component BottomDock inherits Rectangle {
    in property <int> tool: 0;
    in property <length> dock-height: 240px;
    in property <string> terminal-text;
    in property <image> terminal-image;
    in property <[string]> terminal-sessions;
    in property <int> terminal-active: 0;
    in-out property <string> terminal-input;
    in property <[FindRow]> find-rows;
    in-out property <string> find-query;
    in property <string> find-status: "";
    in property <string> output-title;
    in property <[OutputLine]> output-lines;
    in property <bool> output-follow: true;
    in property <[ProblemRow]> problems;
    in property <[GitHistoryRow]> git-history;

    callback close();
    callback resized(length);
    callback resize-reset();
    callback terminal-new();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);
    callback terminal-send(string);
    callback find-search(string);
    callback find-open(string, int);
    callback output-clear();
    callback output-toggle-follow();

    height: root.dock-height;
    background: Theme.surface-panel;

    // One label table for the header — the same strings the bottom bar's
    // tabs show, so the dock header can never drift from its tab.
    property <[string]> tool-titles: [
        "Terminal",
        "Search",
        "Output",
        "Git History",
        "Problems",
    ];

    // ── Resize handle: drag the top edge, double-click restores ─────────
    Rectangle {
        y: 0;
        height: 5px;
        background: resize-touch.has-hover || resize-touch.pressed
            ? Theme.accent.transparentize(0.55) : transparent;

        resize-touch := TouchArea {
            mouse-cursor: ns-resize;
            changed pressed-y => {
                if self.pressed {
                    root.resized(self.pressed-y - self.mouse-y);
                }
            }
            double-clicked => { root.resize-reset(); }
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }

    VerticalLayout {
        padding-top: 4px;

        // ── Contextual header: active tool + its actions ─────────────────
        Rectangle {
            height: 26px;

            Text {
                x: 10px;
                text: root.tool < 0 || root.tool >= root.tool-titles.length
                    ? "" : root.tool-titles[root.tool];
                color: Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            HorizontalLayout {
                padding-right: 6px;
                spacing: 2px;
                alignment: end;

                if root.tool == 0 : ToolbarIcon {
                    y: 2px;
                    glyph: "+";
                    tint: Theme.text-muted;
                    clicked => { root.terminal-new(); }
                }
                if root.tool == 2 && root.output-title != "" : ToolbarIcon {
                    y: 2px;
                    glyph: "∅";
                    clicked => { root.output-clear(); }
                }

                ToolbarIcon {
                    y: 2px;
                    glyph: "×";
                    tint: Theme.text-muted;
                    clicked => { root.close(); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if tool == 0 : TerminalView {
            text: root.terminal-text;
            image: root.terminal-image;
            sessions: root.terminal-sessions;
            active-session: root.terminal-active;
            input <=> root.terminal-input;
            new-session => { root.terminal-new(); }
            terminal-focus(i) => { root.terminal-focus(i); }
            terminal-close(i) => { root.terminal-close(i); }
            terminal-scroll(d) => { root.terminal-scroll(d); }
            terminal-send(t) => { root.terminal-send(t); }
        }
        if tool == 1 : FindView {
            rows: root.find-rows;
            query <=> root.find-query;
            status-text: root.find-status;
            search(q) => { root.find-search(q); }
            open(path, line) => { root.find-open(path, line); }
        }
        if tool == 2 : OutputView {
            title: root.output-title;
            lines: root.output-lines;
            follow: root.output-follow;
            clear => { root.output-clear(); }
            toggle-follow => { root.output-toggle-follow(); }
            open(path, line) => { root.find-open(path, line); }
        }
        if tool == 3 : HistoryView {
            rows: root.git-history;
        }
        if tool == 4 : ProblemsView {
            rows: root.problems;
            open(path, line) => { root.find-open(path, line); }
        }
    }
}
