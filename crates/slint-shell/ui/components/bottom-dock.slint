import { Theme } from "../theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Button } from "button.slint";

export struct FindRow {
    title: string,
    detail: string,
    path: string,
    line: int,
}

export struct GitHistoryRow {
    hash: string,
    author: string,
    date: string,
    message: string,
}

component HeaderAction inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    in property <length> glyph-size: Theme.font-ui;
    callback clicked();

    width: 24px;
    height: 22px;
    border-radius: Theme.radius;
    background: touch.has-hover ? (danger ? Theme.danger : Theme.fill-muted) : transparent;

    Text {
        text: root.glyph;
        color: touch.has-hover ? Theme.text-primary : Theme.text-muted;
        font-size: root.glyph-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DockButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    width: label-text.preferred-width + 34px;
    height: 22px;
    border-radius: Theme.radius;
    background: active ? Theme.fill : (touch.has-hover ? Theme.fill-muted : transparent);

    Text {
        x: 7px;
        width: 16px;
        text: root.glyph;
        color: root.active ? Theme.text-primary : Theme.text-faint;
        font-family: "Symbols Nerd Font";
        font-size: 13px;
        vertical-alignment: center;
    }

    label-text := Text {
        x: 26px;
        text: root.label;
        color: root.active ? Theme.text-primary : Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BottomBar inherits Rectangle {
    in property <int> active: 0;
    callback toggle(int);

    height: 26px;
    background: Theme.surface-panel;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 2px;
        alignment: start;

        DockButton {
            glyph: "\u{EA85}";
            label: "Terminal";
            active: root.active == 0;
            clicked => { root.toggle(0); }
        }
        DockButton {
            glyph: "\u{EA6D}";
            label: "Find";
            active: root.active == 1;
            clicked => { root.toggle(1); }
        }
        DockButton {
            glyph: "\u{F0279}";
            label: "Output";
            active: root.active == 2;
            clicked => { root.toggle(2); }
        }
        DockButton {
            glyph: "\u{F062C}";
            label: "Git";
            active: root.active == 3;
            clicked => { root.toggle(3); }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}

component TerminalTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback selected();
    callback closed();

    height: 26px;
    width: Math.max(104px, label-text.preferred-width + 44px);
    background: active ? Theme.tab-active : ((touch.has-hover || close-touch.has-hover) ? Theme.tab-hover : transparent);
    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;

    touch := TouchArea {
        width: root.width - 24px;
        height: root.height;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    label-text := Text {
        x: 10px;
        width: Math.max(0px, root.width - 38px);
        text: root.label;
        color: root.active ? Theme.text-primary : ((touch.has-hover || close-touch.has-hover) ? Theme.text-primary : Theme.text-muted);
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: root.width - 24px;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius;
        opacity: (root.active || touch.has-hover || close-touch.has-hover) ? 1.0 : 0.0;
        background: close-touch.has-hover ? Theme.danger : transparent;

        Text {
            text: "×";
            color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.active || touch.has-hover || close-touch.has-hover {
                    root.closed();
                }
            }
        }
    }
}

export component TerminalView inherits Rectangle {
    in property <string> text;
    in property <image> image;
    in property <[string]> sessions;
    in property <int> active-session: 0;
    callback new-session();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);

    background: Theme.surface;

    property <length> tabs-h: sessions.length > 0 ? 26px : 0px;
    property <length> body-h: Math.floor((root.height - self.tabs-h) / 20px) * 20px;

    // ── Session tabs ────────────────────────────────────────────────────
    if sessions.length > 0 : Rectangle {
        y: 0;
        height: 26px;
        background: Theme.chrome;
        clip: true;

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.fill-muted;
        }

        HorizontalLayout {
            padding-left: 4px;
            spacing: 0px;
            alignment: start;

            for s[i] in root.sessions : TerminalTab {
                label: s;
                active: i == root.active-session;
                selected => { root.terminal-focus(i); }
                closed => { root.terminal-close(i); }
            }
        }
    }

    if sessions.length == 0 : Text {
        width: 100%;
        height: 100%;
        text: "No terminal session. Start one to use the shell.";
        color: Theme.text-faint;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if sessions.length == 0 : Button {
        label: "Start Terminal";
        width: 130px;
        x: (root.width - 130px) / 2;
        y: root.height / 2 + 18px;
        primary: true;
        clicked => { root.new-session(); }
    }

    if image.width > 0 : Image {
        y: root.tabs-h;
        width: 100%;
        height: root.body-h;
        source: root.image;
        image-fit: fill;
        image-rendering: smooth;
    }

    if image.width > 0 : TouchArea {
        y: root.tabs-h;
        width: 100%;
        height: root.body-h;
        clicked => { root.terminal-focus(root.active-session); }
        scroll-event(event) => {
            root.terminal-scroll(event.delta-y);
            accept
        }
    }

    ScrollView {
        visible: root.text != "" && image.width == 0;
        y: root.tabs-h;
        height: root.body-h;
        Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: 11px;
            wrap: no-wrap;
        }
    }
}

export component FindView inherits Rectangle {
    in property <[FindRow]> rows;
    callback open(string, int);

    background: Theme.surface;

    if rows.length == 0 : Text {
        width: 100%;
        height: 100%;
        text: "No results. Run a build or search to fill this list.";
        color: Theme.text-faint;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ListView {
        for row[i] in root.rows : Rectangle {
            height: 22px;
            background: touch.has-hover ? Theme.fill-muted : transparent;

            Text {
                x: 8px;
                text: row.title;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
            Text {
                x: 300px;
                text: row.detail;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
                width: root.width - self.x - 8px;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open(row.path, row.line); }
            }
        }
    }
}

export component OutputView inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <[FindRow]> rows;
    callback open(string, int);

    background: Theme.surface;

    if text == "" && rows.length == 0 : Text {
        width: 100%;
        height: 100%;
        text: "No task output yet. Run, build, or test to fill this panel.";
        color: Theme.text-faint;
        font-size: Theme.font-small;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    HorizontalLayout {
        if root.text != "" : ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            Text {
                text: root.text;
                color: Theme.text-secondary;
                font-size: 11px;
                wrap: no-wrap;
                horizontal-alignment: left;
            }
        }

        if rows.length > 0 : Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface-panel;

            VerticalLayout {
                Rectangle {
                    height: 18px;
                    Text {
                        x: 8px;
                        text: "PROBLEMS";
                        color: Theme.text-faint;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                ListView {
                    for row[i] in root.rows : Rectangle {
                        height: 20px;
                        background: touch.has-hover ? Theme.fill-muted : transparent;

                        Text {
                            x: 8px;
                            text: "⚠";
                            color: Theme.danger;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 28px;
                            text: row.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 220px;
                            text: row.detail;
                            color: Theme.warning;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            overflow: elide;
                            width: parent.width - self.x - 8px;
                        }

                        touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open(row.path, row.line); }
                        }
                    }
                }
            }
        }
    }
}

export component HistoryView inherits Rectangle {
    in property <[GitHistoryRow]> rows;
    background: Theme.surface;

    if rows.length == 0 : Text {
        width: 100%;
        height: 100%;
        text: "No history. Open a repository to see commits.";
        color: Theme.text-faint;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ListView {
        for row[i] in root.rows : Rectangle {
            height: 24px;
            background: touch.has-hover ? Theme.fill-muted : transparent;

            Text {
                x: 8px;
                width: 70px;
                text: row.hash;
                color: Theme.accent;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 82px;
                width: 150px;
                text: row.author;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 236px;
                width: 120px;
                text: row.date;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 360px;
                width: root.width - 368px;
                text: row.message;
                color: Theme.text-primary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }

            touch := TouchArea { mouse-cursor: default; }
        }
    }
}

export component BottomDock inherits Rectangle {
    in property <int> tool: 0;
    in property <string> title;
    in property <string> terminal-text;
    in property <image> terminal-image;
    in property <[string]> terminal-sessions;
    in property <int> terminal-active: 0;
    in property <[FindRow]> find-rows;
    in property <string> output-title;
    in property <string> output-text;
    in property <[FindRow]> output-rows;
    in property <[GitHistoryRow]> git-history;

    callback close();
    callback terminal-new();
    callback terminal-focus(int);
    callback terminal-close(int);
    callback terminal-scroll(length);
    callback find-open(string, int);

    height: 200px;
    background: Theme.surface-panel;

    VerticalLayout {
        Rectangle {
            height: 26px;
            background: Theme.surface-panel;

            Text {
                x: 8px;
                text: root.title;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            if root.tool == 0 : HeaderAction {
                x: root.width - 52px;
                y: 2px;
                glyph: "+";
                glyph-size: Theme.font-icon;
                clicked => { root.terminal-new(); }
            }

            HeaderAction {
                x: root.width - 28px;
                y: 2px;
                glyph: "×";
                danger: true;
                clicked => { root.close(); }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if tool == 0 : TerminalView {
            text: root.terminal-text;
            image: root.terminal-image;
            sessions: root.terminal-sessions;
            active-session: root.terminal-active;
            new-session => { root.terminal-new(); }
            terminal-focus(i) => { root.terminal-focus(i); }
            terminal-close(i) => { root.terminal-close(i); }
            terminal-scroll(d) => { root.terminal-scroll(d); }
        }
        if tool == 1 : FindView {
            rows: root.find-rows;
            open(path, line) => { root.find-open(path, line); }
        }
        if tool == 2 : OutputView {
            title: root.output-title;
            text: root.output-text;
            rows: root.output-rows;
            open(path, line) => { root.find-open(path, line); }
        }
        if tool == 3 : HistoryView {
            rows: root.git-history;
        }
    }
}
