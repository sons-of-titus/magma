import { Theme } from "../theme.slint";

export component Breadcrumb inherits Rectangle {
    in property <[string]> segments;

    height: Theme.breadcrumb-height;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;

        for seg[i] in root.segments : HorizontalLayout {
            spacing: 4px;
            if i > 0 : Text {
                text: "›";
                color: Theme.text-faint;
                font-size: Theme.font-ui;
                vertical-alignment: center;
            }
            Text {
                text: seg;
                color: i == root.segments.length - 1 ? Theme.text-secondary : Theme.text-faint;
                font-size: Theme.font-ui;
                vertical-alignment: center;
            }
        }
    }
}
