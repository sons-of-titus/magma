import { Theme } from "../theme.slint";

// Path segments are links: clicking one reveals that directory in the
// project tree.  The last segment (the open file) is plain text.
export component Breadcrumb inherits Rectangle {
    in property <[string]> segments;
    callback segment-clicked(int);

    height: Theme.breadcrumb-height;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;

        for seg[i] in root.segments : HorizontalLayout {
            spacing: 4px;
            if i > 0 : Text {
                text: "›";
                color: Theme.text-faint;
                font-size: Theme.font-ui;
                vertical-alignment: center;
            }

            Rectangle {
                border-radius: Theme.radius;
                background: crumb-touch.has-hover && i < root.segments.length - 1
                    ? Theme.fill-muted : transparent;

                min-width: seg-text.preferred-width + 8px;
                height: parent.height;

                seg-text := Text {
                    text: seg;
                    color: i == root.segments.length - 1 ? Theme.text-secondary
                        : crumb-touch.has-hover ? Theme.text-primary
                        : Theme.text-faint;
                    font-size: Theme.font-ui;
                    vertical-alignment: center;
                }

                crumb-touch := TouchArea {
                    mouse-cursor: i < root.segments.length - 1 ? pointer : default;
                    enabled: i < root.segments.length - 1;
                    clicked => { root.segment-clicked(i); }
                }
            }
        }
    }
}
