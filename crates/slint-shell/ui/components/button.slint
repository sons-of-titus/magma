import { Theme } from "../theme.slint";

export component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    width: label-text.preferred-width + 24px;
    border-radius: Theme.radius;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    background: !enabled
        ? Theme.fill-muted
        : primary
            ? (touch.pressed ? Theme.accent.darker(0.18)
                : (touch.has-hover ? Theme.accent.darker(0.08) : Theme.accent))
            : (touch.has-hover ? Theme.fill : Theme.fill-muted);

    label-text := Text {
        text: root.label;
        color: !root.enabled ? Theme.text-faint : (root.primary ? white : Theme.text-primary);
        font-size: Theme.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ToolbarIcon inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.text-muted;
    in property <bool> enabled: true;
    /// Glyph comes from the bundled Symbols Nerd Font rather than the UI font.
    in property <bool> symbol: false;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: Theme.radius;
    background: enabled && touch.has-hover ? Theme.fill : transparent;

    if root.symbol : Text {
        text: root.glyph;
        color: root.enabled ? root.tint : Theme.text-faint;
        font-family: "Symbols Nerd Font";
        font-size: Theme.font-ui;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.symbol : Text {
        text: root.glyph;
        color: root.enabled ? root.tint : Theme.text-faint;
        font-size: Theme.font-ui;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
