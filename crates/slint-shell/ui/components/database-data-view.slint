import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Field } from "controls.slint";
import { EmptyState } from "tool-window.slint";
import { DbTabInfo, DbGridColumn, DbCell, DbGridRow, ToolButton } from "database-panel.slint";

component GridHeaderCell inherits Rectangle {
    in property <string> name;
    in property <string> type;
    in property <string> sort;
    in property <bool> last;
    callback clicked();
    callback resized(length);

    background: Theme.chrome;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 10px;
        spacing: 4px;
        alignment: start;

        Text {
            text: root.name;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 700;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.type != "" : Text {
            text: root.type;
            color: Theme.text-faint;
            font-size: 9px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.sort == "asc" ? "▲" : root.sort == "desc" ? "▼" : "";
            color: Theme.accent;
            font-size: 8px;
            vertical-alignment: center;
            width: 8px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    handle := Rectangle {
        x: parent.width - 4px;
        width: 7px;
        TouchArea {
            mouse-cursor: ew-resize;
            moved => { root.resized(self.mouse-x - self.pressed-x); }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }
}

export component DatabaseDataView inherits Rectangle {
    in property <[DbTabInfo]> tabs;
    in property <[DbGridColumn]> columns;
    in property <[DbGridRow]> rows;
    in-out property <string> grid-filter;
    in property <string> status;
    in property <bool> status-error: false;
    in property <bool> truncated: false;
    in property <string> row-count;
    in property <string> elapsed;
    in property <string> page-info;
    in property <bool> can-edit: false;
    in property <int> pending-count: 0;
    in property <bool> busy: false;
    in property <bool> connected: false;
    in property <int> selected-row: -1;
    in property <int> selected-col: -1;
    in property <bool> can-prev-page: false;
    in property <bool> can-next-page: false;

    callback tab-selected(int);
    callback tab-closed(int);
    callback sort-clicked(int);
    callback filter-accepted();
    callback grid-select(int, int);
    callback grid-edit-committed(int, int, string);
    callback grid-action(string);
    callback col-resized(int, length);
    callback toolbar(string);

    background: Theme.surface;

    property <length> grid-width: root.columns.length == 0 ? 0px
        : 30px + root.columns[root.columns.length - 1].width * root.columns.length;
    property <int> editing-row: -1;
    property <int> editing-col: -1;
    property <string> editing-text: "";
    property <string> editing-original: "";

    function discard-editing() {
        root.editing-row = -1;
        root.editing-col = -1;
        root.editing-text = "";
        root.editing-original = "";
    }

    function commit-editing() {
        if (root.editing-row >= 0 && root.editing-col >= 0) {
            if (root.editing-text != root.editing-original) {
                root.grid-edit-committed(root.editing-row, root.editing-col, root.editing-text);
            }
            root.discard-editing();
        }
    }

    function start-editing(r: int, c: int, initial: string, is-null: bool) {
        if (root.editing-row == r && root.editing-col == c) {
            return;
        }
        root.commit-editing();
        root.editing-row = r;
        root.editing-col = c;
        root.editing-text = is-null ? "" : initial;
        root.editing-original = root.editing-text;
    }

    VerticalLayout {
        spacing: 0px;

        // ── Grid toolbar ─────────────────────────────────────────────────
        Rectangle {
            height: 28px;
            background: Theme.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;
                alignment: start;

                ToolButton {
                    glyph: "\u{F0415}";
                    tooltip: "Insert row (staged)";
                    enabled: root.can-edit;
                    clicked => {
                        root.commit-editing();
                        root.grid-action("insert");
                    }
                }
                ToolButton {
                    glyph: "\u{F0374}";
                    tooltip: "Delete selected row (staged)";
                    enabled: root.can-edit;
                    clicked => {
                        root.commit-editing();
                        root.grid-action("delete");
                    }
                }
                ToolButton {
                    glyph: "\u{F012C}";
                    tooltip: "Apply pending changes";
                    enabled: root.can-edit;
                    tint: root.pending-count > 0 ? Theme.success : Theme.text-faint;
                    clicked => {
                        root.commit-editing();
                        root.grid-action("apply");
                    }
                }
                ToolButton {
                    glyph: "\u{F054C}";
                    tooltip: "Revert pending changes";
                    enabled: root.can-edit;
                    clicked => {
                        root.discard-editing();
                        root.grid-action("revert");
                    }
                }
                ToolButton {
                    glyph: "\u{F018F}";
                    tooltip: "Copy selected cell";
                    clicked => {
                        root.commit-editing();
                        root.grid-action("copy-cell");
                    }
                }
                ToolButton {
                    glyph: "\u{F0450}";
                    tooltip: "Reload page";
                    clicked => {
                        root.discard-editing();
                        root.grid-action("refresh");
                    }
                }
                ToolButton {
                    glyph: "\u{EA91}";
                    tooltip: "Toggle table structure / data";
                    clicked => {
                        root.discard-editing();
                        root.grid-action("structure");
                    }
                }
                ToolButton {
                    glyph: "\u{F03CC}";
                    tooltip: "Jump to referenced row / table";
                    clicked => {
                        root.commit-editing();
                        root.grid-action("follow-fk");
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if root.pending-count > 0 : Text {
                    text: root.pending-count + " pending";
                    color: Theme.warning;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Field {
                    width: 220px;
                    placeholder: "WHERE filter…";
                    font-size: 10px;
                    text <=> root.grid-filter;
                    accepted => {
                        root.commit-editing();
                        root.filter-accepted();
                    }
                }
            }
        }

        // ── Grid ─────────────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            if root.columns.length == 0 && root.busy : Text {
                text: "Loading…";
                color: Theme.text-faint;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.columns.length == 0 && !root.busy && root.status != "" : EmptyState {
                glyph: root.status-error ? "\u{F0028}" : "\u{F012C}";
                title: root.status-error ? "Error" : root.status;
                detail: root.status-error ? root.status : "";
            }

            if root.columns.length == 0 && !root.busy && root.status == "" : EmptyState {
                glyph: "\u{F04EB}";
                title: root.connected ? "Nothing open" : "Not connected";
                detail: root.connected
                    ? "Click a table to browse its data, or run SQL from a console."
                    : "Connect to a data source first.";
                action-label: root.connected ? "Open Console" : "";
                action => { root.toolbar("console"); }
            }

            if root.columns.length > 0 && root.rows.length == 0 && root.busy : Text {
                text: "Loading…";
                color: Theme.text-faint;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.columns.length > 0 && (root.rows.length > 0 || !root.busy) : VerticalLayout {
                spacing: 0px;

                // Header, horizontally bound to the body.
                Rectangle {
                    height: 22px;
                    background: Theme.chrome;

                    header-scroll := ScrollView {
                        content-width: root.grid-width;
                        content-x <=> body-scroll.content-x;

                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                width: 30px;
                                background: Theme.chrome;
                                Text {
                                    text: "#";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    font-family: Theme.font-mono;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: parent.width - 1px;
                                    width: 1px;
                                    height: parent.height;
                                    background: Theme.border;
                                }
                            }
                            for col[col-idx] in root.columns : GridHeaderCell {
                                width: col.width;
                                name: col.name;
                                type: col.type;
                                sort: col.sort;
                                clicked => { root.sort-clicked(col-idx); }
                                resized(d) => { root.col-resized(col-idx, d); }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // Body rows: the fetch is capped (200),
                // so one ScrollView keeps rows in a canvas.
                body-scroll := ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: root.grid-width;

                    VerticalLayout {
                        alignment: start;
                        for row[row-no] in root.rows : Rectangle {
                            height: 20px;
                            width: root.grid-width;
                            background: row.status == "deleted" ? Theme.danger.transparentize(0.94)
                                : row.status == "inserted" ? Theme.success.transparentize(0.94)
                                : root.selected-row == row-no ? Theme.fill-muted
                                : transparent;

                            Rectangle {
                                width: 30px;
                                height: parent.height;
                                background: Theme.chrome;
                                Text {
                                    text: row.number;
                                    color: root.selected-row == row-no ? Theme.accent : Theme.text-faint;
                                    font-size: 9px;
                                    font-family: Theme.font-mono;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: parent.width - 1px;
                                    width: 1px;
                                    height: parent.height;
                                    background: Theme.border;
                                }
                            }

                            HorizontalLayout {
                                x: 30px;
                                width: parent.width - 30px;
                                spacing: 0px;
                                alignment: start;

                                for cell[col-idx] in row.cells : Rectangle {
                                    width: root.columns[col-idx].width;
                                    height: parent.height;
                                    background: root.editing-row == row-no && root.editing-col == col-idx
                                        ? Theme.accent.transparentize(0.85)
                                        : root.selected-row == row-no && root.selected-col == col-idx
                                        ? Theme.accent.transparentize(0.88)
                                        : cell.edited ? Theme.warning.transparentize(0.9)
                                        : transparent;

                                    Text {
                                        x: 6px;
                                        width: parent.width - (cell.fk ? 22px : 10px);
                                        text: cell.text;
                                        color: cell.kind == "null" ? Theme.text-faint
                                            : cell.kind == "blob" ? Theme.warning
                                            : cell.kind == "pk" ? Theme.warning
                                            : cell.kind == "fk" ? Theme.accent
                                            : cell.kind == "number" ? Theme.accent
                                            : cell.kind == "bool" ? Theme.success
                                            : Theme.text-primary;
                                        font-italic: cell.kind == "null";
                                        font-size: 11px;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if row.status == "deleted" : Rectangle {
                                        width: parent.width;
                                        height: 1px;
                                        y: parent.height / 2;
                                        background: Theme.danger;
                                    }

                                    cell-touch := TouchArea {
                                        mouse-cursor: root.can-edit && row.status != "deleted" ? text : default;
                                        clicked => {
                                            if root.can-edit && row.status != "deleted" && (row.status == "inserted" || (root.selected-row == row-no && root.selected-col == col-idx)) {
                                                root.grid-select(row-no, col-idx);
                                                root.start-editing(row-no, col-idx, cell.text, cell.kind == "null");
                                            } else {
                                                root.commit-editing();
                                                root.grid-select(row-no, col-idx);
                                            }
                                        }
                                        double-clicked => {
                                            if root.can-edit && row.status != "deleted" {
                                                root.grid-select(row-no, col-idx);
                                                root.start-editing(row-no, col-idx, cell.text, cell.kind == "null");
                                            } else if cell.fk {
                                                root.commit-editing();
                                                root.grid-select(row-no, col-idx);
                                                root.grid-action("follow-fk");
                                            }
                                        }
                                    }

                                    if cell.fk : Rectangle {
                                        x: parent.width - 18px;
                                        y: 2px;
                                        width: 16px;
                                        height: parent.height - 4px;
                                        border-radius: 3px;
                                        background: fk-touch.has-hover ? Theme.fill : transparent;
                                        Text {
                                            text: "↗";
                                            color: Theme.accent;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        fk-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.commit-editing();
                                                root.grid-select(row-no, col-idx);
                                                root.grid-action("follow-fk");
                                            }
                                        }
                                    }

                                    if root.editing-row == row-no && root.editing-col == col-idx : Rectangle {
                                        x: 2px;
                                        width: parent.width - 4px;
                                        height: parent.height - 4px;
                                        y: 2px;
                                        background: Theme.surface;
                                        border-width: 1px;
                                        border-color: Theme.accent;

                                        init => {
                                            editor.focus();
                                            editor.select-all();
                                        }

                                        editor := TextInput {
                                            x: 4px;
                                            width: parent.width - 8px;
                                            text: root.editing-text;
                                            color: Theme.text-primary;
                                            font-size: 11px;
                                            font-family: Theme.font-mono;
                                            single-line: true;
                                            edited => {
                                                root.editing-text = self.text;
                                            }
                                            accepted => {
                                                root.commit-editing();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Footer: pagination + status
                Rectangle {
                    height: 22px;
                    background: root.status-error
                        ? Theme.danger.transparentize(0.92)
                        : Theme.chrome;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            text: root.status;
                            color: root.status-error ? Theme.danger : Theme.text-secondary;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.page-info != "" : Text {
                            text: root.page-info;
                            color: Theme.text-faint;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                        if root.row-count != "" : Text {
                            text: root.row-count;
                            color: Theme.text-faint;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                        if root.elapsed != "" : Text {
                            text: root.elapsed;
                            color: Theme.text-faint;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                        if root.truncated : Text {
                            text: "truncated";
                            color: Theme.warning;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        ToolButton {
                            glyph: "◀";
                            tooltip: "Previous page";
                            enabled: root.can-prev-page;
                            clicked => {
                                root.commit-editing();
                                root.grid-action("prev");
                            }
                        }
                        ToolButton {
                            glyph: "▶";
                            tooltip: "Next page";
                            enabled: root.can-next-page;
                            clicked => {
                                root.commit-editing();
                                root.grid-action("next");
                            }
                        }
                    }
                }
            }
        }
    }
}
