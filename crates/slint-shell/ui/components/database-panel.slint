import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { ToolWindowHeader, Field, Picker } from "controls.slint";
import { EmptyState } from "tool-window.slint";

// ── Models ───────────────────────────────────────────────────────────────────

// Explorer row, flattened from the kernel's per-source tree cache.  `key`
// is the node path the kernel addresses nodes by.
export struct DbTreeRow {
    key: string,
    depth: int,
    kind: string,       // source | database | schema | folder | table | view | column | pk | fk | index | sequence | function
    label: string,
    detail: string,
    status: string,     // loaded | loading | error
    expanded: bool,
    has-children: bool,
}

export struct DbTabInfo {
    id: int,
    title: string,
    busy: bool,
    pending: bool,
    active: bool,
}

export struct DbGridColumn {
    name: string,
    type: string,
    width: length,
    sort: string,       // "" | asc | desc
}

// One cell: `kind` styles NULL/bool/number/blob; `edited` marks a pending
// change; `new` marks the staged insert row.
export struct DbCell {
    text: string,
    kind: string,
    edited: bool,
    fk: bool,
}

export struct DbGridRow {
    cells: [DbCell],
    status: string,     // "" | deleted | inserted
    number: string,
}

// ── Small pieces ─────────────────────────────────────────────────────────────

export component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Theme.text-muted;
    callback clicked();

    height: 22px;
    width: 24px;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent
        : root.active ? Theme.fill
        : touch.has-hover ? Theme.fill-muted : transparent;

    Text {
        text: root.glyph;
        color: !root.enabled ? Theme.text-faint : root.tint;
        font-family: "Symbols Nerd Font";
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Panel ────────────────────────────────────────────────────────────────────

export component DatabasePanel inherits Rectangle {
    // ── Bound to shell state ─────────────────────────────────────────────
    in property <[string]> sources;
    in property <string> active-source;
    in property <bool> connected: false;
    in property <string> connection-label;
    in property <bool> busy: false;
    in property <bool> querying: false;
    in property <[DbTreeRow]> tree;
    in-out property <string> tree-filter;
    in property <bool> tree-filter-active: false;

    // ── Callbacks ────────────────────────────────────────────────────────
    callback source-changed(string);
    callback toolbar(string);
    callback tree-clicked(string);
    callback tree-opened(string);
    callback tree-context(string, length, length);
    callback tree-filter-edited();

    background: Theme.surface-panel;

    VerticalLayout {
        // ── Header ───────────────────────────────────────────────────────
        ToolWindowHeader {
            title: "Database";
            glyph: "\u{E64D}";
            status-text: root.busy ? "working…"
                : root.connected ? root.connection-label
                : root.connection-label != "" ? "connection failed"
                : "not connected";
            status-tint: root.busy ? Theme.warning
                : root.connected ? Theme.success
                : root.connection-label != "" ? Theme.danger
                : Theme.text-faint;
        }

        // ── Connection bar ───────────────────────────────────────────────
        Rectangle {
            height: 30px;
            background: Theme.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 3px;
                alignment: start;

                Picker {
                    y: 2px;
                    width: Math.max(88px, parent.width - 232px);
                    choices: root.sources;
                    current-value: root.active-source;
                    min-w: 88px;
                    placeholder: "no sources";
                    changed(v) => { root.source-changed(v); }
                }

                ToolButton {
                    glyph: "\u{F0415}";
                    tooltip: "Add data source";
                    tint: Theme.success;
                    clicked => { root.toolbar("add"); }
                }
                ToolButton {
                    glyph: root.connected ? "\u{F06A6}" : "\u{F06A5}";
                    tooltip: root.connected ? "Disconnect" : "Connect";
                    enabled: root.active-source != "";
                    tint: root.connected ? Theme.warning : Theme.success;
                    clicked => { root.toolbar("connect"); }
                }
                ToolButton {
                    glyph: "\u{F0450}";
                    tooltip: "Synchronize";
                    enabled: root.connected;
                    clicked => { root.toolbar("refresh"); }
                }
                ToolButton {
                    glyph: "\u{F018D}";
                    tooltip: "New query console";
                    enabled: root.active-source != "";
                    clicked => { root.toolbar("console"); }
                }
                ToolButton {
                    glyph: root.querying ? "\u{F04DB}" : "\u{F040A}";
                    tooltip: root.querying ? "Cancel running query" : "Run focused console";
                    enabled: root.connected;
                    tint: root.querying ? Theme.danger : Theme.text-muted;
                    clicked => { root.toolbar("run"); }
                }
                ToolButton {
                    glyph: "\u{F0AA6}";
                    tooltip: "Collapse all";
                    enabled: root.connected;
                    clicked => { root.toolbar("collapse"); }
                }
                ToolButton {
                    glyph: "\u{F0232}";
                    tooltip: "Filter objects";
                    active: root.tree-filter-active;
                    clicked => { root.toolbar("filter"); }
                }
                ToolButton {
                    glyph: "\u{F0493}";
                    tooltip: "Data source properties";
                    enabled: root.active-source != "";
                    clicked => { root.toolbar("properties"); }
                }
            }
        }

        // ── Object filter field ──────────────────────────────────────────
        if root.tree-filter-active : Rectangle {
            height: 28px;
            background: Theme.chrome;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 2px;
                padding-bottom: 2px;
                Field {
                    placeholder: "search database objects…";
                    font-size: Theme.font-small;
                    text <=> root.tree-filter;
                    edited => { root.tree-filter-edited(); }
                }
            }
        }

        // ── Explorer ─────────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            if root.sources.length == 0 : EmptyState {
                glyph: "\u{E64D}";
                title: "No data sources";
                detail: "Add one to browse its tables and run SQL.";
                action-label: "Add Data Source";
                action => { root.toolbar("add"); }
            }
            if root.sources.length > 0 && !root.connected : EmptyState {
                glyph: "\u{F06A5}";
                title: root.connection-label != "" ? "Connection failed" : "Not connected";
                detail: root.connection-label != "" ? root.connection-label : "Connect to explore the catalog.";
                action-label: root.connection-label != "" ? "Retry" : "Connect";
                action => { root.toolbar("connect"); }
            }

            if root.connected : ListView {
                for row in root.tree : Rectangle {
                    height: 20px;
                    background: row-touch.has-hover ? Theme.fill-muted : transparent;

                    HorizontalLayout {
                        padding-left: 6px + row.depth * 12px;
                        padding-right: 6px;
                        spacing: 5px;
                        alignment: start;

                        Text {
                            width: 10px;
                            text: !row.has-children ? ""
                                : row.expanded ? "▾" : "▸";
                            color: Theme.text-faint;
                            font-size: 9px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: row.kind == "source" ? "\u{F048B}"
                                : row.kind == "database" ? "\u{F01BC}"
                                : row.kind == "schema" ? "\u{F0645}"
                                : row.kind == "folder" ? "\u{F024B}"
                                : row.kind == "table" ? "\u{F04EB}"
                                : row.kind == "view" ? "\u{F0208}"
                                : row.kind == "column" ? "\u{F0835}"
                                : row.kind == "pk" ? "\u{F0306}"
                                : row.kind == "fk" ? "\u{F0337}"
                                : row.kind == "index" ? "\u{F0241}"
                                : row.kind == "sequence" ? "\u{F03A0}"
                                : row.kind == "function" ? "\u{F0295}"
                                : "";
                            color: row.status == "error" ? Theme.danger
                                : row.kind == "pk" ? Theme.warning
                                : row.kind == "table" || row.kind == "view" || row.kind == "source" ? Theme.accent
                                : Theme.text-faint;
                            font-family: "Symbols Nerd Font";
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: row.label;
                            color: row.status == "error" ? Theme.danger
                                : row.kind == "table" || row.kind == "view" || row.kind == "source" ? Theme.text-primary
                                : Theme.text-secondary;
                            font-size: row.kind == "source" || row.kind == "table" || row.kind == "view"
                                ? Theme.font-small : 10px;
                            font-weight: row.kind == "source" ? 600 : 400;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if row.detail != "" : Text {
                            text: row.detail;
                            color: Theme.text-faint;
                            font-size: 9px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if row.status == "loading" : Text {
                            text: "…";
                            color: Theme.warning;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.tree-clicked(row.key); }
                        double-clicked => { root.tree-opened(row.key); }
                        pointer-event(pe) => {
                            if pe.kind == PointerEventKind.down && pe.button == PointerEventButton.right {
                                root.tree-context(row.key,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }
    }
}
