import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ToolbarIcon } from "button.slint";

export component DebuggerPanel inherits Rectangle {
    in property <bool> active: false;
    in property <[string]> frames;
    in property <string> console;
    callback command(string);

    background: Theme.base;

    VerticalLayout {
        Rectangle {
            height: 30px;

            Text {
                x: 10px;
                text: "Debugger";
                color: Theme.subtext0;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            ToolbarIcon {
                glyph: "▶";
                tint: Theme.green;
                x: 70px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-continue"); }
            }
            ToolbarIcon {
                glyph: "II";
                x: 96px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-pause"); }
            }
            ToolbarIcon {
                glyph: "■";
                tint: Theme.red;
                x: 122px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-stop"); }
            }
            ToolbarIcon {
                glyph: "→";
                x: 150px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-step-over"); }
            }
            ToolbarIcon {
                glyph: "↘";
                x: 176px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-step-in"); }
            }
            ToolbarIcon {
                glyph: "↗";
                x: 202px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-step-out"); }
            }
            ToolbarIcon {
                glyph: "⟳";
                x: 228px;
                y: 3px;
                enabled: root.active;
                clicked => { root.command("dbg-restart"); }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if !root.active : Text {
            width: 100%;
            height: 80px;
            text: "No active debug session. Start one from the Run menu.";
            color: Theme.overlay0;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if root.active : HorizontalLayout {
            padding-left: 10px;
            padding-top: 6px;
            Text {
                text: "CALL STACK";
                color: Theme.overlay0;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if root.active : ScrollView {
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                for frame in root.frames : Text {
                    height: 20px;
                    text: frame;
                    color: Theme.subtext1;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.frames.length == 0 : Text {
                    text: "Running…";
                    color: Theme.overlay0;
                    font-size: Theme.font-small;
                }
            }
        }

        if root.active && root.console != "" : HorizontalLayout {
            padding-left: 10px;
            padding-top: 6px;
            Text {
                text: "CONSOLE";
                color: Theme.overlay0;
                font-size: 10px;
                font-weight: 600;
            }
        }

        if root.active && root.console != "" : ScrollView {
            Text {
                text: root.console;
                color: Theme.subtext0;
                font-size: 11px;
                wrap: no-wrap;
            }
        }
    }
}
