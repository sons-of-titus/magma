import { Theme } from "../theme.slint";

export component EditorView inherits Rectangle {
    in property <image> pane;
    in property <length> pane-width: 0px;
    in property <length> pane-height: 0px;
    in property <string> pane-message;
    in property <image> minimap;
    in property <bool> minimap-visible: false;
    in property <image> gutter;
    in property <bool> gutter-visible: false;
    in property <length> gutter-width: 0px;
    in property <length> cursor-x: 0px;
    in property <length> cursor-y: 0px;
    in property <length> cursor-height: 20px;
    in property <bool> caret-visible: false;
    in property <color> caret-color: Theme.accent;
    in property <bool> enabled: true;
    in property <bool> scrollbar-visible: false;
    in property <float> scrollbar-size: 1;
    in property <float> scrollbar-pos: 0;
    callback scrollbar-dragged(float);

    out property <length> view-width: self.width;
    out property <length> view-height: self.height;

    callback key(string, bool, bool, bool, bool);
    callback mouse-pressed-left(length, length, bool, bool, bool, bool);
    callback mouse-pressed-right(length, length, bool, bool, bool, bool);
    callback mouse-pressed-middle(length, length);
    callback mouse-moved(length, length);
    callback mouse-hover(length, length);
    callback mouse-released();
    callback ime-committed(string);
    callback mouse-scrolled(length, length, length, length, bool, bool, bool, bool);

    background: Theme.surface;
    clip: true;

    init => { ime.focus(); }

    Image {
        // Explicit origin: without it the image is centered in the view and
        // the text lands a few pixels below the gutter and caret overlays.
        x: 0;
        y: 0;
        source: root.pane;
        width: root.pane-width;
        height: root.pane-height;
        image-fit: fill;
        // The pane is blitted at device resolution; nearest-neighbour keeps
        // glyph texels crisp instead of smearing them on resample.
        image-rendering: pixelated;
    }

    if root.gutter-visible : Image {
        x: 0;
        y: 0;
        width: root.gutter-width;
        height: root.pane-height;
        source: root.gutter;
        image-fit: fill;
        image-rendering: pixelated;
    }

    if root.minimap-visible : Image {
        x: root.width - 90px;
        y: 0;
        width: 90px;
        height: 100%;
        source: root.minimap;
        image-fit: fill;
    }

    if root.pane-message != "" : Text {
        text: root.pane-message;
        color: Theme.text-faint;
        font-size: Theme.font-ui;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Thin caret, drawn as an overlay: a grid-stamped caret can only color
    // whole cells, which paints over the character under it.
    Rectangle {
        x: root.cursor-x;
        y: root.cursor-y;
        width: 2px;
        height: root.cursor-height;
        visible: root.caret-visible;
        background: root.caret-color;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        // Text I-beam over the text area; the gutter is for markers and line
        // numbers, so the pointer reverts to the default arrow there.
        mouse-cursor: self.mouse-x < root.gutter-width ? MouseCursor.default : MouseCursor.text;

        moved => {
            if (self.pressed) {
                root.mouse-moved(self.mouse-x, self.mouse-y);
            }
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.mouse-pressed-left(self.mouse-x, self.mouse-y,
                        event.modifiers.control, event.modifiers.shift,
                        event.modifiers.alt, event.modifiers.meta);
                } else if (event.button == PointerEventButton.right) {
                    root.mouse-pressed-right(self.mouse-x, self.mouse-y,
                        event.modifiers.control, event.modifiers.shift,
                        event.modifiers.alt, event.modifiers.meta);
                } else if (event.button == PointerEventButton.middle) {
                    root.mouse-pressed-middle(self.mouse-x, self.mouse-y);
                }
            }
            if (event.kind == PointerEventKind.up) {
                root.mouse-released();
            }
            if (event.kind == PointerEventKind.move) {
                root.mouse-hover(self.mouse-x, self.mouse-y);
            }
        }

        scroll-event(event) => {
            root.mouse-scrolled(self.mouse-x, self.mouse-y,
                event.delta-x, event.delta-y,
                event.modifiers.control, event.modifiers.shift,
                event.modifiers.alt, event.modifiers.meta);
            accept
        }

        clicked => { ime.focus(); }
    }

    if root.scrollbar-visible : Rectangle {
        x: root.width - self.width - (root.minimap-visible ? 90px : 0px);
        y: 0;
        width: 12px;
        height: root.height;

        property <length> thumb-h: max(28px, root.scrollbar-size * self.height);
        property <length> thumb-y: root.scrollbar-pos * (self.height - self.thumb-h);

        Rectangle {
            x: parent.width - 8px;
            y: parent.thumb-y;
            width: 6px;
            height: parent.thumb-h;
            border-radius: 3px;
            background: bar-touch.pressed ? Theme.accent
                : bar-touch.has-hover ? Theme.text-faint : Theme.fill-strong;
            animate background { duration: 120ms; }
        }

        bar-touch := TouchArea {
            mouse-cursor: pointer;
            function drag() {
                root.scrollbar-dragged(clamp(
                    (self.mouse-y - parent.thumb-h / 2) / max(1px, parent.height - parent.thumb-h),
                    0, 1));
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    self.drag();
                }
            }
            moved => {
                if (self.pressed) { self.drag(); }
            }
        }
    }

    scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        // This scope is declared after (thus above) the TouchArea, so the
        // default `focus-on-click` would accept the press, and Slint stops
        // dispatching it to the items below — the editor never saw the click.
        // Key focus belongs to the IME field, which the pane focuses itself.
        focus-on-click: false;

        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.shift,
                     event.modifiers.alt, event.modifiers.meta);
            accept
        }
    }

    // Invisible IME capture surface. Receives composition commits and
    // forwards them; normal key handling stays on the FocusScope above.
    ime := TextInput {
        x: root.cursor-x;
        y: root.cursor-y;
        width: 2px;
        height: root.cursor-height;
        opacity: 0.01;
        enabled: root.enabled;

        edited => {
            if (self.text != "") {
                root.ime-committed(self.text);
                self.text = "";
            }
        }

        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.shift,
                     event.modifiers.alt, event.modifiers.meta);
            accept
        }
    }
}
