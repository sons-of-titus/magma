import { Theme } from "../theme.slint";

export struct ProgressTask {
    label: string,
    detail: string,
}

// Slim activity strip above the bottom bar: one chip per in-flight async
// job (file scan, symbol indexing, session restore, task detection), with a
// continuously sweeping hairline.  Hidden entirely when nothing runs, so a
// settled project shows no reserved dead space.
export component ProgressStrip inherits Rectangle {
    in property <[ProgressTask]> tasks;

    height: 22px;
    background: Theme.surface-panel;

    Rectangle {
        y: 0;
        height: 1px;
        width: 100%;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;
        alignment: start;

        for t in tasks : HorizontalLayout {
            spacing: 6px;
            pulse := Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: Theme.accent;
                opacity: 0.3 + 0.7 * abs(sin(360deg * animation-tick() / 1.2s));
            }

            Text {
                text: t.label;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }

            if t.detail != "" : Text {
                text: t.detail;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 2px;
        clip: true;

        sweep := Rectangle {
            width: parent.width / 4;
            height: 100%;
            background: Theme.accent;
            opacity: 0.75;
            x: mod(animation-tick() / 1.4s, 1.0) * (parent.width + self.width) - self.width;
        }
    }
}
