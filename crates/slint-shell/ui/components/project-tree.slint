import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct TreeItem {
    name: string,
    path: string,
    depth: int,
    is-dir: bool,
    ignored: bool,
    modified: bool,
    has-error: bool,
    expanded: bool,
    icon: string,
    icon-color: color,
    icon-path: string,
    icon-image: image,
}

component TreeRow inherits Rectangle {
    in property <TreeItem> item;
    in property <bool> selected: false;
    callback activated();

    height: Theme.row-height;
    background: selected ? Theme.selected : (touch.has-hover ? Theme.surface1 : transparent);

    Text {
        x: item.depth * 14px + 8px;
        width: 14px;
        text: item.is-dir ? (item.expanded ? "▾" : "▸") : "";
        color: Theme.overlay0;
        font-size: Theme.font-small;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    if item.icon-path != "" : Image {
        x: item.depth * 14px + 22px;
        width: 16px;
        height: 16px;
        source: item.icon-image;
        opacity: item.ignored ? 0.4 : 1.0;
    }

    if item.icon-path == "" : Text {
        x: item.depth * 14px + 22px;
        width: 16px;
        text: item.icon;
        color: item.icon-color;
        font-family: "Symbols Nerd Font";
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        opacity: item.ignored ? 0.4 : 1.0;
    }

    Text {
        x: item.depth * 14px + 42px;
        width: parent.width - (item.depth * 14px + 50px);
        text: item.name;
        color: item.has-error ? Theme.red : (item.ignored ? Theme.overlay0 : (item.modified ? Theme.blue : (item.is-dir ? Theme.lavender : (selected ? Theme.text : Theme.subtext1))));
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
        opacity: item.ignored ? 0.5 : 1.0;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component ProjectTree inherits Rectangle {
    in property <string> title: "Project";
    in property <[TreeItem]> rows;
    in property <string> selected-path;
    in property <string> empty-message: "No project open";
    callback activated(string);
    callback refresh();
    callback collapse();

    background: Theme.base;
    border-width: 0;

    VerticalLayout {
        Rectangle {
            height: 30px;

            Text {
                x: 10px;
                text: root.title;
                color: Theme.subtext0;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: root.width - 44px;
                width: 16px;
                text: "↻";
                color: refresh-touch.has-hover ? Theme.text : Theme.overlay0;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;

                refresh-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh(); }
                }
            }

            Text {
                x: root.width - 24px;
                width: 16px;
                text: "−";
                color: collapse-touch.has-hover ? Theme.text : Theme.overlay0;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;

                collapse-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.collapse(); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        ScrollView {
            VerticalLayout {
                for row in root.rows : TreeRow {
                    item: row;
                    selected: row.path == root.selected-path;
                    activated => { root.activated(row.path); }
                }

                if root.rows.length == 0 : Text {
                    text: root.empty-message;
                    color: Theme.overlay0;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
