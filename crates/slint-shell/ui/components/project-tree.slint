import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";

export struct TreeItem {
    name: string,
    path: string,
    depth: int,
    is-dir: bool,
    ignored: bool,
    modified: bool,
    has-error: bool,
    expanded: bool,
    icon: string,
    icon-color: color,
    icon-path: string,
    icon-image: image,
}

component TreeRow inherits Rectangle {
    in property <TreeItem> item;
    in property <bool> selected: false;
    callback activated();
    callback context-menu(length, length);

    height: Theme.row-height;
    background: selected ? Theme.selection : (touch.has-hover ? Theme.fill : transparent);

    Text {
        x: item.depth * 14px + 8px;
        width: 14px;
        text: item.is-dir ? (item.expanded ? "▾" : "▸") : "";
        color: Theme.text-faint;
        font-size: Theme.font-small;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    if item.icon-path != "" : Image {
        x: item.depth * 14px + 22px;
        width: 16px;
        height: 16px;
        source: item.icon-image;
        opacity: item.ignored ? 0.4 : 1.0;
    }

    if item.icon-path == "" : Text {
        x: item.depth * 14px + 22px;
        width: 16px;
        text: item.icon;
        color: item.icon-color;
        font-family: "Symbols Nerd Font";
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        opacity: item.ignored ? 0.4 : 1.0;
    }

    Text {
        x: item.depth * 14px + 42px;
        width: parent.width - (item.depth * 14px + 50px);
        text: item.name;
        color: item.has-error ? Theme.danger : (item.ignored ? Theme.text-faint : (item.modified ? Theme.accent : (item.is-dir ? Theme.accent-muted : (selected ? Theme.text-primary : Theme.text-secondary))));
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
        opacity: item.ignored ? 0.5 : 1.0;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-menu(self.absolute-position.x + self.mouse-x,
                                  self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component ProjectTree inherits Rectangle {
    in property <string> title: "Project";
    in property <[TreeItem]> rows;
    in property <string> selected-path;
    in property <string> empty-message: "No project open";
    callback activated(string);
    callback context-menu(string, length, length);
    callback refresh();
    callback collapse();

    background: Theme.surface;
    border-width: 0;

    VerticalLayout {
        Rectangle {
            height: 30px;

            Text {
                x: 10px;
                text: root.title;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            Rectangle {
                x: root.width - 44px;
                y: 4px;
                width: 18px;
                height: 22px;
                border-radius: Theme.radius;
                background: refresh-touch.has-hover ? Theme.fill : transparent;

                Text {
                    text: "↻";
                    color: refresh-touch.has-hover ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                refresh-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh(); }
                }
            }

            Rectangle {
                x: root.width - 24px;
                y: 4px;
                width: 18px;
                height: 22px;
                border-radius: Theme.radius;
                background: collapse-touch.has-hover ? Theme.fill : transparent;

                Text {
                    text: "−";
                    color: collapse-touch.has-hover ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                collapse-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.collapse(); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ListView, not ScrollView+for: a plain loop instantiates every file
        // row of the repo, and the scene re-walks them on every keystroke's
        // repaint (profiled at ~40% of main-thread time while typing).
        ListView {
            for row in root.rows : TreeRow {
                item: row;
                selected: row.path == root.selected-path;
                activated => { root.activated(row.path); }
                context-menu(x, y) => { root.context-menu(row.path, x, y); }
            }
        }

        if root.rows.length == 0 : Text {
            text: root.empty-message;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
            height: 40px;
        }
    }
}
