import { Theme } from "../theme.slint";

export struct TabItem {
    title: string,
    active: bool,
    modified: bool,
    icon: string,
    icon-color: color,
    icon-path: string,
    icon-image: image,
}

component Tab inherits Rectangle {
    in property <TabItem> item;
    callback selected();
    callback closed();

    height: Theme.tab-height;
    width: Math.max(96px, label.preferred-width + 52px + (item.modified ? 10px : 0px) + (item.icon-path != "" || item.icon != "" ? 18px : 0px));
    background: item.active
        ? Theme.tab-active
        : ((touch.has-hover || close-touch.has-hover) ? Theme.tab-hover : transparent);
    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;

    touch := TouchArea {
        width: root.width - 22px;
        height: root.height;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    // Modified marker: a blue dot before the title, matching the egui tab.
    if item.modified : Rectangle {
        x: 10px;
        y: (root.height - 6px) / 2;
        width: 6px;
        height: 6px;
        border-radius: Theme.radius;
        background: Theme.accent;
    }

    // Icon: SVG image or Nerd Font glyph, before the title.
    if item.icon-path != "" : Image {
        x: (item.modified ? 22px : 10px);
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: item.icon-image;
    }

    if item.icon-path == "" && item.icon != "" : Text {
        x: (item.modified ? 22px : 10px);
        width: 16px;
        text: item.icon;
        color: item.icon-color;
        font-family: "Symbols Nerd Font";
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    label := Text {
        x: (item.modified ? 22px : 10px) + (item.icon-path != "" || item.icon != "" ? 18px : 0px);
        width: Math.max(0px, root.width - ((item.modified ? 22px : 10px) + (item.icon-path != "" || item.icon != "" ? 18px : 0px)) - 30px);
        text: root.item.title;
        color: root.item.active ? Theme.text-primary : ((touch.has-hover || close-touch.has-hover) ? Theme.text-primary : Theme.text-muted);
        font-size: Theme.font-ui;
        vertical-alignment: center;
        overflow: elide;
    }

    // Close affordance appears on the active tab or under the pointer.
    Rectangle {
        x: root.width - 22px;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius;
        opacity: (item.active || touch.has-hover || close-touch.has-hover) ? 1.0 : 0.0;
        background: close-touch.has-hover ? Theme.danger : transparent;

        Text {
            text: "×";
            color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if item.active || touch.has-hover || close-touch.has-hover {
                    root.closed();
                }
            }
        }
    }

}

export component TabStrip inherits Rectangle {
    in property <[TabItem]> tabs;
    callback selected(int);
    callback closed(int);

    height: Theme.tab-height;
    background: Theme.chrome;

    // Strip baseline: the active tab sits above this hairline.
    Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: Theme.fill-muted;
    }

    HorizontalLayout {
        spacing: 0px;
        alignment: start;

        for tab[i] in root.tabs : Tab {
            item: tab;
            selected => { root.selected(i); }
            closed => { root.closed(i); }
        }
    }
}