import { Theme } from "../theme.slint";

export component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.text-muted;
    in property <bool> enabled: true;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: Theme.radius;
    background: enabled && touch.has-hover ? Theme.fill : transparent;

    Text {
        text: root.glyph;
        color: root.enabled ? root.tint : Theme.text-faint;
        font-family: "Symbols Nerd Font";
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ToolBar inherits Rectangle {
    callback run();
    callback debug();
    callback stop();
    callback build();
    callback test();
    callback settings();

    HorizontalLayout {
        spacing: 2px;
        alignment: end;

        ToolButton {
            glyph: "\u{F040D}";
            tint: Theme.success;
            clicked => { root.run(); }
        }
        ToolButton {
            glyph: "\u{EAAF}";
            tint: Theme.text-muted;
            clicked => { root.debug(); }
        }
        ToolButton {
            glyph: "\u{EBA5}";
            tint: Theme.danger;
            clicked => { root.stop(); }
        }
        ToolButton {
            glyph: "\u{F08EA}";
            tint: Theme.text-muted;
            clicked => { root.build(); }
        }
        ToolButton {
            glyph: "\u{F0096}";
            tint: Theme.text-muted;
            clicked => { root.test(); }
        }
        ToolButton {
            glyph: "\u{F0493}";
            tint: Theme.text-muted;
            clicked => { root.settings(); }
        }
    }
}
