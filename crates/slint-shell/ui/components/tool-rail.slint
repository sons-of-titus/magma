import { Theme } from "../theme.slint";

export component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <bool> active: false;
    callback clicked();

    width: Theme.rail-width;
    height: 32px;
    background: active ? Theme.fill-muted : (touch.has-hover ? Theme.fill : transparent);

    // Active tool reads as a 2px accent bar at the window edge.
    Rectangle {
        x: 0;
        y: 6px;
        width: 2px;
        height: root.height - 12px;
        background: root.active ? Theme.accent : transparent;
    }

    Text {
        text: root.glyph;
        color: root.active ? Theme.text-primary : Theme.text-faint;
        font-family: "Symbols Nerd Font";
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ToolRail inherits Rectangle {
    in property <int> active: 0;
    callback selected(int);

    width: Theme.rail-width;
    background: Theme.chrome;
    border-width: 0;

    VerticalLayout {
        padding-top: 8px;
        spacing: 4px;
        alignment: start;

        RailButton {
            glyph: "\u{F024B}";
            name: "Project";
            active: root.active == 0;
            clicked => { root.selected(0); }
        }
        RailButton {
            glyph: "\u{F062C}";
            name: "Commit";
            active: root.active == 1;
            clicked => { root.selected(1); }
        }
        RailButton {
            glyph: "\u{EAAF}";
            name: "Debugger";
            active: root.active == 2;
            clicked => { root.selected(2); }
        }
    }
}

export component RightRail inherits Rectangle {
    in property <bool> open: false;
    callback toggled();

    width: Theme.rail-width;
    background: Theme.chrome;

    VerticalLayout {
        padding-top: 8px;
        spacing: 4px;
        alignment: start;

        RailButton {
            glyph: "\u{EC20}";
            name: "Agent";
            active: root.open;
            clicked => { root.toggled(); }
        }
    }
}
