import { Theme } from "../theme.slint";
import { Button } from "button.slint";
import { ScrollView } from "std-widgets.slint";

export struct RecentProject {
    name: string,
    display: string,
    path: string,
}

export component Welcome inherits Rectangle {
    in property <[RecentProject]> recents;
    callback open-folder();
    callback new-project();
    callback open-recent(string);

    background: Theme.surface;

    VerticalLayout {
        padding: 32px;
        spacing: 10px;

        Text {
            text: "Magma";
            color: Theme.text-primary;
            font-size: 40px;
            font-weight: 700;
        }

        Text {
            text: "A programmable text editor — Rust kernel, Janet userland.";
            color: Theme.text-muted;
            font-size: Theme.font-ui;
        }

        Text {
            text: "Open a folder to start editing, or pick a recent project.";
            color: Theme.text-faint;
            font-size: Theme.font-small;
        }

        Rectangle { height: 8px; }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                label: "New Project…";
                primary: true;
                width: 140px;
                clicked => { root.new-project(); }
            }
            Button {
                label: "Open Folder…";
                width: 140px;
                clicked => { root.open-folder(); }
            }
        }

        Rectangle { height: 6px; }

        Text {
            text: "RECENT PROJECTS";
            color: Theme.text-faint;
            font-size: 10px;
            font-weight: 600;
        }

        if root.recents.length == 0 : Text {
            text: "No recent projects yet.";
            color: Theme.text-faint;
            font-size: Theme.font-small;
        }

        recents-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                for recent in root.recents : Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: recent-touch.has-hover ? Theme.fill-muted : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            width: 16px;
                            text: "\u{f07b}";
                            color: recent-touch.has-hover ? Theme.accent : Theme.text-faint;
                            font-family: "Symbols Nerd Font";
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: recent.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-ui;
                                overflow: elide;
                            }
                            Text {
                                text: recent.display;
                                color: Theme.text-faint;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }

                    recent-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-recent(recent.path); }
                    }
                }
            }
        }


        Text {
            text: "ctrl-f  find    ctrl-shift-f  find in project    ctrl-l  go to line    ctrl-shift-p  commands";
            color: Theme.text-faint;
            font-size: 10px;
        }
    }
}