// Design tokens for the entire shell — the single source for every color,
// metric, and type size.  Rust pushes the active palette into these
// properties from the `gui-theme` option; components never hardcode colors.

export global Theme {
    // ── Surfaces: layered backgrounds, darkest chrome → lightest content ──
    in-out property <color> chrome;         // window furniture: rail, menu, tab strip, headers
    in-out property <color> surface-panel;  // tool windows and docks
    in-out property <color> surface;        // editor viewport, inputs, lists

    // ── Interactive fills, subtle → strong ──
    in-out property <color> fill-muted;     // hover on list rows
    in-out property <color> fill;           // resting controls, hover emphasis
    in-out property <color> fill-strong;    // prominent secondary controls

    // ── Structure ──
    in-out property <color> border;
    in-out property <color> tab-active;
    in-out property <color> tab-hover;
    in-out property <color> selection;

    // ── Text hierarchy ──
    in-out property <color> text-primary;
    in-out property <color> text-secondary;
    in-out property <color> text-muted;
    in-out property <color> text-faint;

    // ── State colors ──
    in-out property <color> accent;
    in-out property <color> accent-muted;
    in-out property <color> success;
    in-out property <color> warning;
    in-out property <color> danger;

    // ── Typography ──
    in-out property <length> font-ui: 12px;
    in-out property <length> font-small: 11px;
    in-out property <length> font-icon: 15px;
    in-out property <string> font-mono;     // editor family, pushed from Rust

    // ── Metrics ──
    out property <length> menu-height: 30px;
    out property <length> tab-height: 30px;
    out property <length> breadcrumb-height: 22px;
    out property <length> status-height: 24px;
    out property <length> rail-width: 32px;
    out property <length> sidebar-width: 240px;
    out property <length> row-height: 24px;
    out property <length> control-height: 26px;
    out property <length> tool-header-height: 32px;

    out property <length> radius: 3px;
    out property <length> radius-pill: 4px;

    out property <duration> motion: 120ms;
}
