import { Theme } from "../theme.slint";

export component DialogView inherits Rectangle {
    in property <string> dialog-title: "";
    in-out property <string> dialog-input: "";

    callback command(string);
    callback close();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #00000066;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - 420px) / 2;
        y: (parent.height - 160px) / 2;
        width: 420px;
        height: 160px;
        background: Theme.surface-panel;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { }
        }
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;

        Text {
            x: 16px;
            y: 12px;
            text: root.dialog-title;
            color: Theme.text-primary;
            font-size: Theme.font-ui;
            font-weight: 600;
        }

        Rectangle {
            x: 16px;
            y: 44px;
            width: parent.width - 32px;
            height: 28px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.chrome;

            TextInput {
                x: 8px;
                width: parent.width - 16px;
                text <=> root.dialog-input;
                color: Theme.text-primary;
                font-size: Theme.font-ui;
                single-line: true;
                accepted => { root.command("dialog:ok"); }
            }
        }

        HorizontalLayout {
            x: 16px;
            y: parent.height - 40px;
            width: parent.width - 32px;
            spacing: 8px;
            alignment: end;

            Rectangle {
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: touch.has-hover ? Theme.fill-muted : Theme.fill;
                Text {
                    text: "Cancel";
                    color: Theme.text-primary;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch := TouchArea {
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: Theme.accent;
                Text {
                    text: "OK";
                    color: Theme.chrome;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.command("dialog:ok"); }
                }
            }
        }
    }
}