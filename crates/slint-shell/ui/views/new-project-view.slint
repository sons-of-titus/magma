import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Field, Picker, Check, SectionLabel } from "../components/controls.slint";
import { Button, ToolbarIcon } from "../components/button.slint";
import { EmptyState } from "../components/tool-window.slint";

// One template in the browser list; the selected one is also pushed as
// `detail` for the right-hand pane.
export struct TemplateItem {
    id: string,
    name: string,
    description: string,
    category: string,
    language: string,
    plugin: string,
    toolchain: string,
    // "" when the declared toolchain is available; otherwise the
    // actionable "not installed" message shown before creating anything.
    toolchain-status: string,
    file-count: int,
    selected: bool,
}

// One template input the user fills in the form.
export struct TemplateVar {
    key: string,
    label: string,
    description: string,
    kind: string,          // "text" | "project-name" | "choice" | "boolean"
    value: string,
    choices: [string],
    required: bool,
}

export component NewProjectView inherits Rectangle {
    // Solo: no project is open, so the wizard is the window's whole content
    // instead of a card floating over the editor chrome.
    in property <bool> solo: false;
    in property <[TemplateItem]> templates;
    in property <TemplateItem> detail;
    // Language sections: display names ("Rust"); `language` is the selected
    // one.  Search spans every language while it is non-empty.
    in property <[string]> languages;
    in property <string> language: "";
    in-out property <string> search: "";
    in-out property <string> project-name: "";
    in-out property <string> dest-dir: "";
    in property <[TemplateVar]> vars;
    in property <string> note: "";
    in property <string> create-reason: "";
    in property <bool> can-create: false;
    in property <bool> generating: false;

    callback close();
    callback create();
    callback browse();
    callback select(int);
    callback language-select(int);
    callback move-selection(int);
    callback search-changed();
    callback var-changed(string, string);
    callback name-changed();
    callback dest-changed();

    property <length> card-w: 760px;
    property <length> card-h: 540px;

    // Codepoints mirror the Nerd Font pack in builtins/icons.janet.
    // Matched lowercased so raw ids and display names both resolve.
    function lang-glyph(name: string) -> string {
        if name.to-lowercase() == "rust" { return "\u{e7a8}"; }
        if name.to-lowercase() == "python" { return "\u{e606}"; }
        if name.to-lowercase() == "go" { return "\u{e627}"; }
        if name.to-lowercase() == "c" || name.to-lowercase() == "cpp" { return "\u{e649}"; }
        if name.to-lowercase() == "javascript" || name.to-lowercase() == "js" { return "\u{e60c}"; }
        if name.to-lowercase() == "typescript" || name.to-lowercase() == "ts" { return "\u{e628}"; }
        if name.to-lowercase() == "janet" { return "\u{f121}"; }
        return "\u{f15c}";
    }

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: root.solo ? Theme.surface : #00000066;

    // The backdrop only closes when nothing is in flight — a stray click
    // must not abandon a generation.  In solo mode there is nothing behind
    // the wizard to click away to.
    if !root.solo : TouchArea {
        clicked => {
            if !root.generating {
                root.close();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.solo ? parent.width : card-w;
        height: root.solo ? parent.height : card-h;
        background: root.solo ? Theme.surface : Theme.surface-panel;
        border-radius: root.solo ? 0px : 8px;
        border-width: root.solo ? 0px : 1px;
        border-color: Theme.border;
        drop-shadow-blur: root.solo ? 0px : 24px;
        drop-shadow-color: #00000077;
        drop-shadow-offset-y: root.solo ? 0px : 6px;

        TouchArea { }

        focus := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if event.text == Key.Escape && !root.generating {
                    root.close();
                    accept
                } else if event.text == Key.Return && root.can-create {
                    root.create();
                    accept
                } else if event.text == Key.UpArrow {
                    root.move-selection(-1);
                    accept
                } else if event.text == Key.DownArrow {
                    root.move-selection(1);
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            // ── Header: drag handle for the solo window ──────────────────
            header := Rectangle {
                height: Theme.menu-height;
                background: Theme.chrome;

                WindowMoveArea {
                    enabled: root.solo;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "\u{f135}";
                            color: Theme.accent;
                            font-family: "Symbols Nerd Font";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "New Project";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolbarIcon {
                            glyph: "✕";
                            enabled: !root.generating;
                            clicked => { root.close(); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                // ── Language sections + template browser ─────────────────
                VerticalLayout {
                    width: 260px;
                    spacing: 8px;

                    Field {
                        placeholder: "Search all templates";
                        text <=> root.search;
                        edited => { root.search-changed(); }
                    }

                    // Language sections: pick the language first, then the
                    // template inside it.  Search spans every language.
                    if root.languages.length > 0 : VerticalLayout {
                        spacing: 4px;

                        SectionLabel { text: "LANGUAGE"; }

                        Rectangle {
                            height: Math.min(root.languages.length * 28px + 8px, 148px);
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;

                            ScrollView {
                                VerticalLayout {
                                    padding: 4px;
                                    for lang[idx] in root.languages : Rectangle {
                                        height: 28px;
                                        border-radius: 3px;
                                        background: lang == root.language
                                            ? Theme.selection
                                            : (lang-touch.has-hover ? Theme.fill : transparent);
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                width: 16px;
                                                text: root.lang-glyph(lang);
                                                color: lang == root.language ? Theme.accent : Theme.text-faint;
                                                font-family: "Symbols Nerd Font";
                                                font-size: 14px;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: lang;
                                                color: lang == root.language ? Theme.text-primary : Theme.text-secondary;
                                                font-size: Theme.font-ui;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        lang-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.language-select(idx); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SectionLabel { text: "TEMPLATES"; }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;

                        if root.templates.length == 0 : EmptyState {
                            width: 100%;
                            height: 100%;
                            glyph: "\u{f002}";
                            title: "No templates match";
                            detail: "Try a different search or language section.";
                        }

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                for t[idx] in root.templates : Rectangle {
                                    height: 44px;
                                    border-radius: 3px;
                                    background: t.selected
                                        ? Theme.selection
                                        : (row-touch.has-hover ? Theme.fill : transparent);

                                    if t.selected : Rectangle {
                                        x: 0;
                                        width: 2px;
                                        height: 100%;
                                        background: Theme.accent;
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            width: 16px;
                                            text: root.lang-glyph(t.language);
                                            color: t.selected ? Theme.accent : Theme.text-faint;
                                            font-family: "Symbols Nerd Font";
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                        VerticalLayout {
                                            vertical-stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: t.name;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-ui;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: t.category + (t.language == "" ? "" : "  ·  " + t.language);
                                                color: Theme.text-faint;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    row-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select(idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Detail + form ────────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    if root.detail.id != "" : ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: root.lang-glyph(root.detail.language);
                                    color: Theme.accent;
                                    font-family: "Symbols Nerd Font";
                                    font-size: 15px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.detail.name;
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.detail.description;
                                color: Theme.text-secondary;
                                font-size: Theme.font-ui;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.detail.plugin + "  ·  " + root.detail.file-count + " files";
                                color: Theme.text-faint;
                                font-size: Theme.font-small;
                            }
                            if root.detail.toolchain-status != "" : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: "\u{f071}";
                                    color: Theme.warning;
                                    font-family: "Symbols Nerd Font";
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.detail.toolchain-status;
                                    color: Theme.warning;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }

                            SectionLabel { text: "LOCATION"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    width: 150px;
                                    text: "Destination";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-ui;
                                    vertical-alignment: center;
                                }
                                Field {
                                    horizontal-stretch: 1;
                                    placeholder: "/path/to/parent/folder";
                                    text <=> root.dest-dir;
                                    enabled: !root.generating;
                                    edited => { root.dest-changed(); }
                                }
                                Button {
                                    label: "Browse…";
                                    enabled: !root.generating;
                                    clicked => { root.browse(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    width: 150px;
                                    text: "Name";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-ui;
                                    vertical-alignment: center;
                                }
                                Field {
                                    width: 220px;
                                    placeholder: "my-project";
                                    text <=> root.project-name;
                                    enabled: !root.generating;
                                    edited => { root.name-changed(); }
                                }
                            }

                            if root.vars.length > 0 : SectionLabel { text: "OPTIONS"; }
                            for v in root.vars : HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                VerticalLayout {
                                    width: 150px;
                                    alignment: v.description == "" ? center : start;
                                    spacing: 1px;
                                    Text {
                                        text: v.label;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-ui;
                                        overflow: elide;
                                    }
                                    if v.description != "" : Text {
                                        text: v.description;
                                        color: Theme.text-faint;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }
                                if v.kind == "choice" : Picker {
                                    y: (parent.height - Theme.control-height) / 2;
                                    choices: v.choices;
                                    current-value: v.value;
                                    changed(value) => { root.var-changed(v.key, value); }
                                }
                                if v.kind == "boolean" : Check {
                                    y: (parent.height - Theme.control-height) / 2;
                                    checked: v.value == "true";
                                    toggled => { root.var-changed(v.key, self.checked ? "true" : "false"); }
                                }
                                if v.kind != "choice" && v.kind != "boolean" : Field {
                                    y: (parent.height - Theme.control-height) / 2;
                                    width: 200px;
                                    placeholder: v.required ? "required" : "optional";
                                    text: v.value;
                                    enabled: !root.generating;
                                    edited => { root.var-changed(v.key, self.text); }
                                }
                            }
                        }
                    }

                    if root.detail.id == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{f15c}";
                        title: "Select a template";
                        detail: "Pick a starting point on the left — the form fills in from it.";
                    }
                }
            }

            // ── Footer ───────────────────────────────────────────────────
            Rectangle {
                height: 38px;
                background: Theme.chrome;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        vertical-alignment: center;
                        text: root.generating
                            ? "Creating project…"
                            : root.note != "" ? root.note : root.create-reason;
                        color: root.generating ? Theme.text-muted
                            : root.note != "" ? Theme.danger : Theme.text-faint;
                        font-size: Theme.font-small;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: "Cancel";
                        enabled: !root.generating;
                        clicked => { root.close(); }
                    }
                    Button {
                        label: root.generating ? "Creating…" : "Create";
                        primary: true;
                        enabled: root.can-create && !root.generating;
                        clicked => { root.create(); }
                    }
                }

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }
}
