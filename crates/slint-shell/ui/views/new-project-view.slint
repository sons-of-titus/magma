import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Field, Picker, Check, SectionLabel } from "../components/controls.slint";
import { Button, ToolbarIcon } from "../components/button.slint";
import { EmptyState } from "../components/tool-window.slint";

// One template in the browser list; the selected one is also pushed as
// `detail` for the right-hand pane.
export struct TemplateItem {
    id: string,
    name: string,
    description: string,
    category: string,
    language: string,
    plugin: string,
    toolchain: string,
    // "" when the declared toolchain is available; otherwise the
    // actionable "not installed" message shown before creating anything.
    toolchain-status: string,
    file-count: int,
    selected: bool,
}

// One template input the user fills in the form.
export struct TemplateVar {
    key: string,
    label: string,
    description: string,
    kind: string,          // "text" | "project-name" | "choice" | "boolean"
    value: string,
    choices: [string],
    required: bool,
}

export component NewProjectView inherits Rectangle {
    // Solo: no project is open, so the wizard is the window's whole content
    // instead of a card floating over the editor chrome.
    in property <bool> solo: false;
    in property <[TemplateItem]> templates;
    in property <TemplateItem> detail;
    // Language sections: display names ("Rust"); `language` is the selected
    // one.  Search spans every language while it is non-empty.
    in property <[string]> languages;
    in property <string> language: "";
    in-out property <string> search: "";
    in-out property <string> project-name: "";
    in-out property <string> dest-dir: "";
    in property <[TemplateVar]> vars;
    in property <string> note: "";
    in property <string> create-reason: "";
    in property <bool> name-invalid: false;
    in property <bool> dest-invalid: false;
    in property <bool> can-create: false;
    in property <bool> generating: false;

    callback close();
    callback create();
    callback browse();
    callback select(int);
    callback language-select(int);
    callback move-selection(int);
    callback search-changed();
    callback var-changed(string, string);
    callback name-changed();
    callback dest-changed();

    property <string> create-hint: root.project-name == "" || root.dest-dir == "" ? "" : root.dest-dir + "/" + root.project-name;
    property <length> card-w: 880px;
    property <length> card-h: 600px;

    // Codepoints mirror the Nerd Font pack in builtins/icons.janet.
    // Matched lowercased so raw ids and display names both resolve.
    function lang-glyph(name: string) -> string {
        if name.to-lowercase() == "rust" { return "\u{e7a8}"; }
        if name.to-lowercase() == "python" { return "\u{e606}"; }
        if name.to-lowercase() == "go" { return "\u{e627}"; }
        if name.to-lowercase() == "c" || name.to-lowercase() == "cpp" { return "\u{e649}"; }
        if name.to-lowercase() == "javascript" || name.to-lowercase() == "js" { return "\u{e60c}"; }
        if name.to-lowercase() == "typescript" || name.to-lowercase() == "ts" { return "\u{e628}"; }
        if name.to-lowercase() == "janet" { return "\u{f121}"; }
        return "\u{f15c}";
    }

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: root.solo ? Theme.surface : #00000066;

    // The backdrop only closes when nothing is in flight — a stray click
    // must not abandon a generation.  In solo mode there is nothing behind
    // the wizard to click away to.
    if !root.solo : TouchArea {
        clicked => {
            if !root.generating {
                root.close();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.solo ? parent.width : card-w;
        height: root.solo ? parent.height : card-h;
        background: root.solo ? Theme.surface : Theme.surface-panel;
        border-radius: root.solo ? 0px : 8px;
        border-width: root.solo ? 0px : 1px;
        border-color: Theme.border;
        drop-shadow-blur: root.solo ? 0px : 24px;
        drop-shadow-color: #00000077;
        drop-shadow-offset-y: root.solo ? 0px : 6px;

        TouchArea { }

        focus := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if event.text == Key.Escape && !root.generating {
                    root.close();
                    accept
                } else if event.text == Key.Return && root.can-create {
                    root.create();
                    accept
                } else if event.text == Key.UpArrow {
                    root.move-selection(-1);
                    accept
                } else if event.text == Key.DownArrow {
                    root.move-selection(1);
                    accept
                } else {
                    reject
                }
            }
        }


        VerticalLayout {
            header := Rectangle {
                height: Theme.menu-height;
                background: Theme.chrome;

                WindowMoveArea {
                    enabled: root.solo;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "\u{f135}";
                            color: Theme.accent;
                            font-family: "Symbols Nerd Font";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "New Project";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolbarIcon {
                            glyph: "✕";
                            enabled: !root.generating;
                            clicked => { root.close(); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                spacing: 0px;

                // ── Browser: search, language chips, template cards ──────
                Rectangle {
                    width: 290px;
                    background: Theme.surface;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Field {
                            placeholder: "Search templates…";
                            text <=> root.search;
                            edited => { root.search-changed(); }
                        }

                        if root.languages.length > 0 : VerticalLayout {
                            spacing: 5px;
                            SectionLabel { text: root.search != "" ? "LANGUAGE  ·  SEARCHING ALL" : "LANGUAGE"; }

                            Rectangle {
                                height: 30px;
                                ScrollView {
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for lang[idx] in root.languages : Rectangle {
                                            height: 26px;
                                            width: chip-row.preferred-width;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: lang == root.language && root.search == "" ? Theme.accent : Theme.border;
                                            background: lang == root.language && root.search == ""
                                                ? Theme.selection
                                                : (lang-touch.has-hover ? Theme.fill : transparent);
                                            chip-row := HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 5px;
                                                Text {
                                                    text: root.lang-glyph(lang);
                                                    color: lang == root.language ? Theme.accent : Theme.text-faint;
                                                    font-family: "Symbols Nerd Font";
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: lang;
                                                    color: lang == root.language ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: Theme.font-small;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            lang-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.language-select(idx); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        SectionLabel { text: "TEMPLATES  ·  " + root.templates.length; }

                        Rectangle {
                            vertical-stretch: 1;

                            if root.templates.length == 0 : EmptyState {
                                width: 100%;
                                height: 100%;
                                glyph: "\u{f002}";
                                title: "No templates match";
                                detail: "Try a different search or language.";
                            }

                            ScrollView {
                                VerticalLayout {
                                    spacing: 4px;
                                    for t[idx] in root.templates : Rectangle {
                                        height: 52px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: t.selected ? Theme.accent : transparent;
                                        background: t.selected
                                            ? Theme.selection
                                            : (row-touch.has-hover ? Theme.fill : transparent);

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;

                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 6px;
                                                background: t.selected ? Theme.accent.with-alpha(0.18) : Theme.fill;
                                                Text {
                                                    text: root.lang-glyph(t.language);
                                                    color: t.selected ? Theme.accent : Theme.text-muted;
                                                    font-family: "Symbols Nerd Font";
                                                    font-size: 16px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: t.name;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.font-ui;
                                                    font-weight: t.selected ? 700 : 400;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: t.category;
                                                    color: Theme.text-faint;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        row-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.select(idx); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border;
                    }
                }

                // ── Detail + form ────────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 20px;
                    spacing: 10px;

                    if root.detail.id != "" : ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            padding-right: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 10px;
                                    background: Theme.accent.with-alpha(0.18);
                                    Text {
                                        text: root.lang-glyph(root.detail.language);
                                        color: Theme.accent;
                                        font-family: "Symbols Nerd Font";
                                        font-size: 22px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: root.detail.name;
                                        color: Theme.text-primary;
                                        font-size: 16px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.detail.plugin + "  ·  " + root.detail.file-count + " files"
                                            + (root.detail.toolchain == "" ? "" : "  ·  " + root.detail.toolchain);
                                        color: Theme.text-faint;
                                        font-size: Theme.font-small;
                                        overflow: elide;
                                    }
                                }
                            }
                            Text {
                                text: root.detail.description;
                                color: Theme.text-secondary;
                                font-size: Theme.font-ui;
                                wrap: word-wrap;
                            }
                            if root.detail.toolchain-status != "" : Rectangle {
                                border-radius: Theme.radius;
                                background: Theme.warning.with-alpha(0.12);
                                border-width: 1px;
                                border-color: Theme.warning.with-alpha(0.5);
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: "\u{f071}";
                                        color: Theme.warning;
                                        font-family: "Symbols Nerd Font";
                                        font-size: Theme.font-small;
                                        vertical-alignment: top;
                                    }
                                    Text {
                                        text: root.detail.toolchain-status;
                                        color: Theme.warning;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            SectionLabel { text: "PROJECT"; }
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Name";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                                Field {
                                    placeholder: "my-project";
                                    text <=> root.project-name;
                                    invalid: root.name-invalid;
                                    enabled: !root.generating;
                                    edited => { root.name-changed(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Location";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Field {
                                        horizontal-stretch: 1;
                                        placeholder: "/path/to/parent/folder";
                                        text <=> root.dest-dir;
                                        invalid: root.dest-invalid;
                                        enabled: !root.generating;
                                        edited => { root.dest-changed(); }
                                    }
                                    Button {
                                        label: "Browse…";
                                        enabled: !root.generating;
                                        clicked => { root.browse(); }
                                    }
                                }
                                if root.create-hint != "" : Text {
                                    text: "Will be created at " + root.create-hint;
                                    color: Theme.text-faint;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                            }

                            if root.vars.length > 0 : SectionLabel { text: "OPTIONS"; }
                            for v in root.vars : VerticalLayout {
                                spacing: 4px;
                                if v.kind != "boolean" : Text {
                                    text: v.label + (v.required ? " *" : "");
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                                if v.kind == "choice" : Picker {
                                    choices: v.choices;
                                    current-value: v.value;
                                    changed(value) => { root.var-changed(v.key, value); }
                                }
                                if v.kind == "boolean" : Check {
                                    label: v.label;
                                    description: v.description;
                                    checked: v.value == "true";
                                    toggled => { root.var-changed(v.key, self.checked ? "true" : "false"); }
                                }
                                if v.kind != "choice" && v.kind != "boolean" : Field {
                                    placeholder: v.required ? "required" : "optional";
                                    text: v.value;
                                    enabled: !root.generating;
                                    edited => { root.var-changed(v.key, self.text); }
                                }
                                if v.description != "" && v.kind != "boolean" : Text {
                                    text: v.description;
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if root.detail.id == "" : EmptyState {
                        vertical-stretch: 1;
                        glyph: "\u{f15c}";
                        title: "Select a template";
                        detail: "Pick a starting point on the left — the form fills in from it.";
                    }
                }
            }

            // ── Footer ───────────────────────────────────────────────────
            Rectangle {
                height: 46px;
                background: Theme.chrome;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        vertical-alignment: center;
                        text: root.generating
                            ? "Creating project…"
                            : root.note != "" ? root.note
                            : root.create-reason != "" ? root.create-reason
                            : "Ready — press Enter to create";
                        color: root.generating ? Theme.text-muted
                            : root.note != "" ? Theme.danger
                            : root.create-reason != "" ? Theme.text-faint : Theme.text-muted;
                        font-size: Theme.font-small;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: "Cancel";
                        enabled: !root.generating;
                        clicked => { root.close(); }
                    }
                    Button {
                        label: root.generating ? "Creating…" : "Create Project";
                        primary: true;
                        enabled: root.can-create && !root.generating;
                        clicked => { root.create(); }
                    }
                }

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }
}
