import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct CompletionEntry {
    label: string,
    kind: string,
    detail: string,
}

export struct HoverLine {
    text: string,
    kind: string,
}

export component HoverCard inherits Rectangle {
    in property <length> hover-x: 0px;
    in property <length> hover-y: 0px;
    // Pushed from the shell: the same geometry drives the pin hit-test and
    // the edge-flip math, so the rendered size can never drift from it.
    in property <length> hover-height: 100px;
    in property <[HoverLine]> hover-lines;
    callback go-to-definition();

    x: root.hover-x;
    y: root.hover-y;
    width: 420px;
    height: root.hover-height;
    clip: true;
    background: Theme.surface-panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 4px;
                for line in root.hover-lines : Rectangle {
                    height: line-text.preferred-height + 8px;
                    background: line.kind == "code" ? Theme.fill-muted : transparent;
                    border-radius: line.kind == "code" ? 6px : 0px;

                    line-text := Text {
                        x: 8px;
                        y: 4px;
                        width: parent.width - 16px;
                        text: line.text;
                        color: line.kind == "muted" ? Theme.text-secondary : Theme.text-primary;
                        font-size: line.kind == "muted" ? Theme.font-small : Theme.font-ui;
                        font-weight: line.kind == "heading" ? 700 : 400;
                        font-family: line.kind == "code" ? Theme.font-mono : "";
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── Footer link ────────────────────────────────────────────────
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
            }
            Rectangle {
                width: gd-label.preferred-width;
                height: gd-label.preferred-height;
                gd-touch := TouchArea {
                    clicked => { root.go-to-definition(); }
                }
                gd-label := Text {
                    text: "Go to definition";
                    color: gd-touch.has-hover ? Theme.accent : Theme.text-secondary;
                    font-size: Theme.font-small;
                }
            }
        }
    }

}

export component CompletionPopup inherits Rectangle {
    in property <length> completion-x: 0px;
    in property <length> completion-y: 0px;
    in property <[CompletionEntry]> completion-entries;
    in property <int> completion-selected: 0;
    // Signature + documentation of the selected entry, pre-joined by the
    // shell.  It renders in the side pane, never sizing the popup.
    in property <string> completion-info;

    x: root.completion-x;
    y: root.completion-y;
    width: 560px;
    // The list decides the height — the docs pane must never push it.
    height: (root.completion-entries.length * 18px + 8px).min(320px);
    clip: true;
    background: Theme.chrome;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.fill;

    HorizontalLayout {
        // ── Item list ────────────────────────────────────────────────────
        VerticalLayout {
            width: 250px;
            padding: 4px;
            for entry[i] in root.completion-entries : Rectangle {
                height: 18px;
                background: i == root.completion-selected ? Theme.fill : transparent;
                HorizontalLayout {
                    x: 4px;
                    spacing: 6px;
                    Text {
                        text: entry.label;
                        color: i == root.completion-selected ? Theme.text-primary : Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: entry.kind;
                        color: Theme.text-secondary;
                        opacity: 0.6;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
        // ── Divider + docs side pane ─────────────────────────────────────
        Rectangle { width: 1px; background: Theme.fill; }
        if root.completion-info != "" : VerticalLayout {
            padding: 8px;
            Text {
                text: root.completion-info;
                color: Theme.text-secondary;
                font-size: 10px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }
}

export component QuickfixMenu inherits Rectangle {
    in property <length> quickfix-x: 0px;
    in property <length> quickfix-y: 0px;
    in property <[string]> quickfix-items;
    in property <int> quickfix-selected: 0;

    x: root.quickfix-x;
    y: root.quickfix-y;
    width: 260px;
    height: (root.quickfix-items.length * 18px + 10px).min(240px);
    background: Theme.chrome;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.accent;

    VerticalLayout {
        padding: 5px;
        for item[i] in root.quickfix-items : Rectangle {
            height: 18px;
            background: i == root.quickfix-selected ? Theme.fill : transparent;
            Text {
                x: 8px;
                text: item;
                color: i == root.quickfix-selected ? Theme.text-primary : Theme.text-secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
