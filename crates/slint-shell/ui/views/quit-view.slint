import { Theme } from "../theme.slint";

export component QuitView inherits Rectangle {
    in property <string> message: "";
    in property <string> files: "";

    callback command(string);

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #00000066;

    // Backdrop click dismisses, like the other dialogs.
    TouchArea {
        clicked => { root.command("quit:cancel"); }
    }

    Rectangle {
        width: 440px;
        height: 216px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-panel;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { }
        }

        Text {
            x: 16px;
            y: 14px;
            text: "Unsaved Changes";
            color: Theme.text-primary;
            font-size: Theme.font-ui;
            font-weight: 600;
        }

        Text {
            x: 16px;
            y: 42px;
            width: parent.width - 32px;
            text: root.message;
            color: Theme.text-secondary;
            font-size: Theme.font-ui;
            wrap: word-wrap;
        }

        Rectangle {
            x: 16px;
            y: 70px;
            width: parent.width - 32px;
            height: 100px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.chrome;
            clip: true;

            Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.files;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        HorizontalLayout {
            x: 16px;
            y: parent.height - 40px;
            width: parent.width - 32px;
            spacing: 8px;
            alignment: end;

            Rectangle {
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: cancel-touch.has-hover ? Theme.fill-muted : Theme.fill;
                Text {
                    text: "Cancel";
                    color: Theme.text-primary;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cancel-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.command("quit:cancel"); }
                }
            }
            Rectangle {
                width: 130px;
                height: 26px;
                border-radius: Theme.radius;
                background: force-touch.has-hover ? Theme.warning.darker(0.1) : Theme.warning;
                Text {
                    text: "Quit without Saving";
                    color: Theme.chrome;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                force-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.command("quit:force"); }
                }
            }
            Rectangle {
                width: 80px;
                height: 26px;
                border-radius: Theme.radius;
                background: save-touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                Text {
                    text: "Save All";
                    color: Theme.chrome;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                save-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.command("quit:save"); }
                }
            }
        }
    }
}
