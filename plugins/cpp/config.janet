# C++ language configuration.

(option/set "cpp-indent-width" "4")
(option/set "cpp-indent-style" "space")
(option/set "cpp-comment-prefix" "// ")
(option/set "cpp-lsp-command" "clangd")
(option/set "cpp-debug-adapter" "lldb")

# Format with clang-format before every save of a cpp buffer
(option/set "cpp-format-on-save" "false")
