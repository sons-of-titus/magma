# JavaScript language configuration.

(option/set "javascript-indent-width" "2")
(option/set "javascript-indent-style" "space")
(option/set "javascript-comment-prefix" "// ")
(option/set "javascript-lsp-command" "typescript-language-server")
(option/set "javascript-debug-adapter" "node")

# Format with prettier before every save of a javascript buffer
(option/set "javascript-format-on-save" "false")
