# Python language configuration.

(option/set "python-indent-width" "4")
(option/set "python-indent-style" "space")
(option/set "python-comment-prefix" "# ")
(option/set "python-lsp-command" "pylsp")
(option/set "python-max-line-length" "88")

# Format with black before every save of a python buffer
(option/set "python-format-on-save" "false")
