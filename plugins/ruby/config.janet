# Ruby language configuration.

(option/set "ruby-indent-width" "2")
(option/set "ruby-indent-style" "space")
(option/set "ruby-comment-prefix" "# ")
(option/set "ruby-lsp-command" "solargraph")
(option/set "ruby-debug-adapter" "ruby-debug")

# Format with rubocop before every save of a ruby buffer
(option/set "ruby-format-on-save" "false")
