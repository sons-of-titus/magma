# TypeScript language configuration.

(option/set "typescript-indent-width" "2")
(option/set "typescript-indent-style" "space")
(option/set "typescript-comment-prefix" "// ")
(option/set "typescript-lsp-command" "typescript-language-server")
(option/set "typescript-debug-adapter" "node")

# Format with prettier before every save of a typescript buffer
(option/set "typescript-format-on-save" "false")
